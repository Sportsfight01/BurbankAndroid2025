<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".ui.login.EnterPasswordActivity">

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/back_icon_height_width"
        android:layout_height="@dimen/back_icon_height_width"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/_25dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/back_png_grey"
        app:tint="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />



    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        >

        <LinearLayout
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginTop="2dp"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">

            <ImageView
                android:id="@+id/profile_view"
                android:layout_width="@dimen/login_logo"
                android:layout_height="@dimen/login_logo"
                android:layout_alignParentTop="true"
                android:layout_gravity="center"
                android:layout_marginStart="25dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="25dp"
                android:src="@mipmap/logo_myplace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_23sdp"
                android:gravity="start"

                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                     android:textAppearance="@style/FontRegular"
                    android:lineSpacingExtra="6sp"
                    android:text="Enter"
                    android:textColor="@color/black_bg_3.1"
                    android:textSize="@dimen/header_size" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                     android:textAppearance="@style/FontMedium"
                    android:lineSpacingExtra="6sp"
                    android:text="Password"
                    android:textColor="@color/black_bg_3.1"
                    android:textSize="@dimen/header_size" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5dp"
                 android:textAppearance="@style/FontMedium"
                android:text="Enter your password to login"
                android:textColor="@color/black_bg_3.1"
                android:textSize="@dimen/sub_header_size"
                 />


            <LinearLayout
                android:id="@+id/ll_social"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_username"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/disable_gery"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="start|center"
                    android:paddingLeft="16dp"
                    android:textColor="@color/black_bg_3.1"
                    android:textSize="@dimen/text_field_size"
                    tools:text="@string/app_name" />

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/rectangle_grey_line"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="start|center"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="@dimen/_16dp"
                    android:text=""
                    android:textColor="@android:color/black"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/text_field_size" />
            </LinearLayout>

            <TextView

                android:id="@+id/tv_logint"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="40dp"
                android:background="@drawable/rectangle_orange_bg"
                 android:textAppearance="@style/FontMedium"
                android:gravity="center"
                android:lineSpacingExtra="3sp"
                android:text="Login"
                android:textColor="@color/white_3.1"
                android:textSize="@dimen/button_text_size" />

            <LinearLayout
                android:id="@+id/ll_forgot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                     android:textAppearance="@style/FontMedium"
                    android:includeFontPadding="false"
                    android:text="@string/forgot_password"
                    android:textColor="@color/black_bg_3.1"
                    android:textSize="@dimen/sub_header_size"
                     />


            </LinearLayout>

        </LinearLayout>


    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>