<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/appColor"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="@dimen/_30dp"
    android:paddingEnd="@dimen/_10dp">

    <TextView
        android:id="@+id/tv_estateName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_gravity="start"
        android:layout_marginTop="@dimen/_10dp"
         android:textAppearance="@style/FontMedium"
        android:gravity="start"
        android:text="Botanical estate"
        android:textAllCaps="true"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/tv_street_subrub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_estateName"
        android:layout_alignParentStart="true"
        android:layout_gravity="start"
        android:layout_marginBottom="@dimen/_10dp"
         android:textAppearance="@style/FontMedium"
        android:text="Poppy Street, Mickleham"
        android:textAllCaps="false"
        android:textColor="@color/white" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_gravity="end"
        android:background="@drawable/round_line"
        android:gravity="center"
        android:paddingStart="@dimen/_15dp"
        android:paddingTop="@dimen/_8dp"
        android:paddingEnd="@dimen/_15dp"
        android:paddingBottom="@dimen/_8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/_5dp"
             android:textAppearance="@style/FontMedium"
            android:gravity="center"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="@color/black" />

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/_20dp"
            android:layout_height="@dimen/_20dp"
            android:src="@drawable/icon_back_navigation"
            android:tint="@color/white" />
    </LinearLayout>
</RelativeLayout>

