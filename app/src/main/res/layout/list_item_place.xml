<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/body_bg_3.1"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="@dimen/_10dp"
        android:orientation="horizontal">

        <RelativeLayout
            android:id="@+id/rl_place"
            android:layout_width="@dimen/_130dp"
            android:layout_height="@dimen/_90dp">

            <ImageView
                android:id="@+id/iv_place"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:background="@drawable/rectangle_test" />

            <ProgressBar
                android:id="@+id/place_progress"
                android:layout_width="@dimen/_30dp"
                android:layout_height="@dimen/_30dp"
                android:layout_centerInParent="true" />
        </RelativeLayout>


        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:paddingStart="16dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:textAppearance="@style/FontMedium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4sp"
                android:text="$434,296"
                android:textColor="@color/orange_bg_3.1"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/header"
                android:layout_marginTop="3dp"
                 android:textAppearance="@style/FontMedium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3sp"
                android:text="Chatﬁeld 206"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_title"
                 android:textAppearance="@style/FontRegular"
                android:includeFontPadding="false"
                android:text="Lot 1535 Grainger Parade"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_area"
                android:layout_marginTop="5dp"
                android:gravity="center|start">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/third_eminities" />

                <TextView
                    android:id="@+id/tv_bedrooms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="5dp"
                     android:textAppearance="@style/FontRegular"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/grey_text_font_3.1"
                    android:text="2"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:layout_marginLeft="5dp"
                    android:src="@drawable/bath_eminities" />

                <TextView
                    android:id="@+id/tv_bathrooms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="5dp"
                     android:textAppearance="@style/FontRegular"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/grey_text_font_3.1"
                    android:text="3"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:layout_marginLeft="5dp"
                    android:src="@drawable/car_eminities" />

                <TextView
                    android:id="@+id/tv_carspaces"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="5dp"
                     android:textAppearance="@style/FontRegular"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/grey_text_font_3.1"
                    android:text="4"
                    android:textSize="14sp" />


            </LinearLayout>

            <ImageView
                android:id="@+id/iv_like"
                android:layout_width="@dimen/_30dp"
                android:layout_height="@dimen/_30dp"
                android:layout_alignParentEnd="true"
                android:padding="4dp"
                android:src="@drawable/heart_bottom_svg" />
        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>