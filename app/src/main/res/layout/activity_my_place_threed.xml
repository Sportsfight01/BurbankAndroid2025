<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.designs.myplacethreed.MyPlaceThreedActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constant_vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <RelativeLayout
            android:id="@+id/rl_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_16dp"
            android:paddingTop="@dimen/_25dp"
            android:paddingEnd="@dimen/_25dp"
            android:paddingBottom="@dimen/_25dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/ll_header"
                android:layout_alignParentStart="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_back"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:rotation="180"
                    android:src="@drawable/icon_back_navigation"
                     />

                <TextView
                    android:layout_marginStart="@dimen/_10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                     android:textAppearance="@style/FontExtraBold"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="6sp"
                    android:text="My"
                    android:textColor="@color/black"
                    android:textSize="29sp" />

                <TextView
                    android:id="@+id/tv_header_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                     android:textAppearance="@style/FontExtraBold"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="6sp"
                    android:paddingStart="6dp"
                    android:text="Place"
                    android:textColor="@color/black"
                    android:textSize="29sp" />

                <TextView
                    android:id="@+id/tv_threed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                     android:textAppearance="@style/FontExtraBold"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="6sp"
                    android:paddingStart="6dp"
                    android:text="3D"
                    android:textColor="@color/appColor"
                    android:textSize="29sp" />
            </LinearLayout>

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/myplace_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rl_header">

            <pl.droidsonroids.gif.GifImageView
                android:id="@+id/iv_zif"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_centerInParent="true"
                android:src="@drawable/my_place_threed" />

            <TextView
                android:id="@+id/tv_rotate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_zif"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/_14dp"
                 android:textAppearance="@style/FontMedium"
                android:text="rotate your"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/_20sp" />

            <TextView
                android:id="@+id/tv_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_rotate"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/_5dp"
                 android:textAppearance="@style/FontMedium"
                android:text="phone to enter"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="@dimen/_20sp" />

        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constant_horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <im.delight.android.webview.AdvancedWebView
            android:id="@+id/webView"
            android:hardwareAccelerated="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </im.delight.android.webview.AdvancedWebView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>