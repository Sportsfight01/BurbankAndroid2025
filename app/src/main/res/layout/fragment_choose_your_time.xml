<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/body_bg_3.1"
    tools:context=".ui.mydisplay.nearby.ChooseYourTimeFragment">

    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_8dp">

        <TextView
            android:id="@+id/tv_choose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_5dp"
             android:textAppearance="@style/FontMedium"
            android:gravity="center"
            android:text="Choose your time"
            android:textAllCaps="true"
            android:textColor="@color/grey_text_font_3.1"
            android:textSize="@dimen/_16sp" />

        <LinearLayout
            android:id="@+id/ll_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/_5dp"
            android:layout_marginBottom="@dimen/_5dp"
            android:background="@drawable/round_line_enable_orange"
            android:gravity="center"
            android:paddingStart="12dp"
            android:layout_marginEnd="@dimen/_10dp"
            android:paddingTop="@dimen/_3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="@dimen/_3dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/_2dp"
                 android:textAppearance="@style/FontMedium"
                android:gravity="center"

                android:text="Back"
                android:textAllCaps="false"
                android:textSize="@dimen/default_text_size"
                android:textColor="@color/white_3.1" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/back_png_grey"
                app:tint="@color/white_3.1" />
        </LinearLayout>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/ll_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_header"
        android:background="@color/enabled_orange_bg_3.1"
        android:gravity="start"
        android:orientation="vertical"
        android:paddingStart="@dimen/_20dp"
        android:paddingEnd="@dimen/_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_gravity="start"
            android:layout_marginTop="@dimen/_10dp"
             android:textAppearance="@style/FontMedium"
            android:gravity="start"
            android:text="Botanical estate"
            android:textAllCaps="true"
            android:textSize="@dimen/default_text_size"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_ondisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_header"
            android:layout_alignParentStart="true"
            android:layout_gravity="start"
            android:layout_marginBottom="@dimen/_10dp"
            android:layout_toStartOf="@+id/ll_end"
             android:textAppearance="@style/FontMedium"
            android:maxLines="2"
            android:textSize="@dimen/default_text_size"
            android:text="Poppy Street, Mickleham Poppy Street Mickleham Poppy Street "
            android:textAllCaps="false"
            android:textColor="@color/white" />


        <LinearLayout
            android:id="@+id/ll_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_gravity="end"
            android:gravity="center"
            android:paddingStart="@dimen/_10dp"
            android:paddingTop="@dimen/_8dp"
            android:paddingBottom="@dimen/_8dp">

            <TextView
                android:id="@+id/tv_street_suburb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/_5dp"
                 android:textAppearance="@style/FontMedium"
                android:gravity="end"
                android:text="Poppy Street,\nMickleham"
                android:textSize="@dimen/default_text_size"
                android:textAllCaps="false"
                android:textColor="@color/grey_text_font_3.1" />

        </LinearLayout>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ll_container">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:padding="@dimen/_16dp">

                <TextView
                    android:id="@+id/tv_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_5dp"
                    android:textAppearance="@style/FontMedium"
                    android:text="Tuesday,March 3"
                    android:textAllCaps="false"
                    android:textColor="@color/grey_text_font_3.1"
                    android:textSize="@dimen/_16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_day"
                    android:layout_marginTop="@dimen/_20dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_morning"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5dp"
                        android:background="@drawable/rectangle_grey_line"
                        android:textAppearance="@style/FontMedium"
                        android:gravity="center"
                        android:text="@string/morning"
                        android:textAllCaps="true"
                        android:textColor="@color/grey_text_font_3.1"
                        android:textSize="16sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_middle"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5dp"
                        android:background="@drawable/rectangle_grey_line"
                        android:textAppearance="@style/FontMedium"
                        android:gravity="center"
                        android:text="@string/middle_of_the_day"
                        android:textAllCaps="true"
                        android:textColor="@color/grey_text_font_3.1"
                        android:textSize="16sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_afternoon"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/_5dp"
                        android:layout_marginBottom="@dimen/_20dp"
                        android:background="@drawable/rectangle_grey_line"
                        android:textAppearance="@style/FontMedium"
                        android:gravity="center"
                        android:text="@string/afternoon"
                        android:textAllCaps="true"
                        android:textColor="@color/grey_text_font_3.1"
                        android:textSize="16sp"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </LinearLayout>


            </RelativeLayout>

        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>


</RelativeLayout>