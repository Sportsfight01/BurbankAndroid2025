<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/body_bg_3.1"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.mydisplay.favoritesDisplays.FavoriteChooseYourTimeCommentFragment">

    <include layout="@layout/homeland_tool" />

    <RelativeLayout
        android:layout_below="@+id/rl_top"
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_16dp">

        <TextView
            android:id="@+id/tv_choose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_5dp"
             android:textAppearance="@style/FontMedium"
            android:gravity="center"
            android:text="Choose your time"
            android:textAllCaps="true"
            android:textColor="@color/grey_text_font_3.1"
            android:textSize="@dimen/_18sp" />

        <LinearLayout
            android:id="@+id/ll_back"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_gravity="end"
            android:background="@drawable/orangebutton"
            android:gravity="center"
            android:paddingStart="@dimen/_15dp"
            android:paddingTop="@dimen/_8dp"
            android:paddingEnd="@dimen/_15dp"
            android:paddingBottom="@dimen/_8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/_5dp"
                 android:textAppearance="@style/FontMedium"
                android:gravity="center"
                android:text="Back"
                android:textSize="@dimen/default_text_size"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:src="@drawable/icon_back_navigation"
                app:tint="@color/white" />
        </LinearLayout>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/ll_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_header"
        android:background="@color/enabled_orange_bg_3.1"
        android:gravity="start"
        android:orientation="vertical"
        android:paddingStart="@dimen/_20dp"
        android:paddingEnd="@dimen/_10dp">

        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_gravity="start"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_10dp"
             android:textAppearance="@style/FontMedium"
            android:gravity="start"
            android:text="Botanical estate"
            android:textSize="@dimen/default_text_size"
            android:textAllCaps="true"
            android:textColor="@color/white_3.1" />

        <TextView
            android:id="@+id/tv_ondisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_header"
            android:layout_alignParentStart="true"
            android:layout_gravity="start"
            android:layout_marginBottom="@dimen/_10dp"
            android:layout_toStartOf="@+id/ll_end"
             android:textAppearance="@style/FontMedium"
            android:maxLines="2"
            android:textSize="@dimen/default_text_size"
            android:text="Poppy Street, Mickleham Poppy Street Mickleham Poppy Street "
            android:textAllCaps="false"
            android:textColor="@color/white_3.1" />


        <LinearLayout
            android:id="@+id/ll_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_gravity="end"
            android:gravity="center"
            android:paddingStart="@dimen/_10dp"
            android:paddingTop="@dimen/_8dp"
            android:paddingBottom="@dimen/_8dp">

            <TextView
                android:id="@+id/tv_street_suburb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/_5dp"
                 android:textAppearance="@style/FontMedium"
                android:gravity="end"
                android:textSize="@dimen/default_text_size"
                android:text="Poppy Street,\nMickleham"
                android:textAllCaps="false"
                android:textColor="@color/black_bg_3.1" />

        </LinearLayout>
    </RelativeLayout>
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ll_container"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:layout_below="@+id/ll_container">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/_16dp"
            android:visibility="visible"
            android:paddingStart="@dimen/_30dp"
            android:paddingEnd="@dimen/_30dp">

            <TextView
                android:id="@+id/tv_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/_5dp"
                 android:textAppearance="@style/FontRegular"
                android:text="Tuesday,March 3"
                android:textAllCaps="false"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="@dimen/_16sp" />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_day"
                android:layout_marginStart="@dimen/_5dp"
                 android:textAppearance="@style/FontRegular"
                android:text="Morning"
                android:textAllCaps="true"
                android:textColor="@color/orange_bg_3.1"
                android:textSize="@dimen/_14sp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_time"
                android:layout_marginTop="@dimen/_10dp">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/_10dp"
                    android:paddingEnd="@dimen/_10dp"
                    app:layout_constraintGuide_percent="0.5" />

                <EditText
                    android:id="@+id/firstName"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40dp"
                    android:layout_marginEnd="@dimen/_10dp"
                    android:background="@drawable/rectangle_grey_line"
                    android:hint="First Name"
                    android:inputType="text"
                    android:textAppearance="@style/FontMedium"
                    android:lines="1"
                    android:textColor="@color/black_bg_3.1"
                    android:paddingStart="@dimen/_10dp"
                    android:paddingEnd="@dimen/_5dp"
                    android:textSize="@dimen/_14sp"
                    android:textCursorDrawable="@null"
                    app:layout_constraintEnd_toStartOf="@+id/guideline"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/lastName"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40dp"
                    android:layout_marginStart="@dimen/_10dp"
                    android:background="@drawable/rectangle_grey_line"
                    android:hint="Last Name"
                    android:inputType="text"
                    android:paddingStart="@dimen/_10dp"
                    android:paddingEnd="@dimen/_5dp"
                    android:textSize="@dimen/_14sp"
                    android:textCursorDrawable="@null"
                    android:textColor="@color/black_bg_3.1"
                    android:textAppearance="@style/FontMedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guideline"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/phone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40dp"
                    android:layout_marginTop="@dimen/_10dp"
                    android:layout_marginEnd="@dimen/_10dp"
                    android:background="@drawable/rectangle_grey_line"
                    android:digits="0123456789"
                    android:hint="Phone"
                    android:textColor="@color/black_bg_3.1"
                    android:inputType="phone"
                    android:lines="1"
                    android:textAppearance="@style/FontMedium"
                    android:maxLength="14"
                    android:textCursorDrawable="@null"
                    android:paddingStart="@dimen/_10dp"
                    android:paddingEnd="@dimen/_5dp"
                    android:textSize="@dimen/_14sp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/firstName" />

                <EditText
                    android:id="@+id/email"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40dp"
                    android:layout_marginStart="@dimen/_10dp"
                    android:layout_marginTop="@dimen/_10dp"
                    android:background="@drawable/rectangle_grey_line"
                    android:hint="Email"
                    android:textColor="@color/black_bg_3.1"
                    android:inputType="textEmailAddress"
                    android:paddingStart="@dimen/_10dp"
                    android:paddingEnd="@dimen/_5dp"
                    android:textCursorDrawable="@null"
                    android:textSize="@dimen/_14sp"
                    android:textAppearance="@style/FontMedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/lastName" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Spinner
                android:id="@+id/localPlaceSpinner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40dp"
                android:layout_below="@+id/cl_container"
                android:layout_marginTop="10dp"
                android:background="@drawable/rectangle_grey_line" />

            <EditText
                android:id="@+id/et_comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/localPlaceSpinner"
                android:layout_marginTop="@dimen/_10dp"
                android:background="@drawable/rectangle_grey_line"
                android:gravity="start|top"
                android:hint="Comments"
                android:textCursorDrawable="@null"
                android:textColor="@color/black_bg_3.1"
                android:lines="5"
                android:textSize="@dimen/default_text_size"
                android:textAppearance="@style/FontMedium"
                android:padding="@dimen/_16dp" />

            <TextView
                android:id="@+id/tv_we_will"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/btnEnq"
                android:layout_marginStart="@dimen/_5dp"
                android:layout_marginTop="@dimen/_20dp"
                 android:textAppearance="@style/FontRegular"
                android:text="We will schedule the exact time\nonce you let us know your preference "
                android:textAllCaps="false"
                android:visibility="gone"
                android:textColor="@color/black_bg_3.1"
                android:textSize="@dimen/_16sp" />
            <Button
                android:id="@+id/btnEnq"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_below="@+id/consentCheckLL"
                android:layout_marginTop="10dp"
                android:background="@drawable/rectangel_skip"
                 android:textAppearance="@style/FontMedium"
                android:gravity="center"
                android:text="Request Appointment"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/consentCheckLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/et_comment"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_check"
                    android:layout_width="@dimen/_25dp"
                    android:layout_height="@dimen/_25dp"
                    android:src="@drawable/uncheck_checkbox" />

                <TextView
                    android:id="@+id/tv_privacy"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="start"
                    android:paddingStart="@dimen/_10dp"
                    android:paddingEnd="@dimen/_10dp"
                    android:justificationMode="inter_word"
                    android:text="I accept Burbank's privacy policy and wish to receive Burbank's latest news and offers on my email."
                    android:textColor="@color/grey_text_font_3.1"
                    android:textSize="@dimen/_14sp" />
            </LinearLayout>

        </RelativeLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>