<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/_16dp"
    android:paddingEnd="@dimen/_16dp">

    <RelativeLayout
        android:id="@+id/rl_parent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_150"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/house"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/box_grey" />

        <ProgressBar
            android:id="@+id/place_progress"
            android:layout_width="@dimen/_30dp"
            android:layout_height="@dimen/_30dp"
            android:layout_centerInParent="true"
            android:visibility="visible" />

    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/rl_content"
        android:layout_width="wrap_content"
        android:layout_height="90dp"
        android:padding="@dimen/_10dp"
        app:layout_constraintEnd_toEndOf="@+id/rl_parent"
        app:layout_constraintStart_toStartOf="@+id/rl_parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_parent">

        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:textAppearance="@style/FontMedium"
            android:text="All bright estate,Truganina"
            android:textAllCaps="false"
            android:textColor="@color/orange_bg_3.1"
            android:textSize="@dimen/_14sp"
           />

        <LinearLayout
            android:id="@+id/ll_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_header"
            android:layout_marginTop="@dimen/_8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_design"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_20dp"
                app:tint="@color/grey_text_font_3.1"
                android:src="@drawable/icon_designs"/>

            <TextView
                android:id="@+id/tv_designs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5dp"
                android:textAllCaps="true"
                android:textSize="@dimen/default_text_size"
                android:textAppearance="@style/FontRegular"
                android:textColor="@color/grey_text_font_3.1"
                tools:text="2 Designs" />

        </LinearLayout>


        <ImageView
            android:id="@+id/iv_favorite"
            android:layout_width="@dimen/_25dp"
            android:layout_height="@dimen/_25dp"
            android:layout_below="@+id/tv_header"
            android:layout_alignTop="@id/ll_container"
            android:layout_alignParentEnd="true"
            android:src="@drawable/heart_bottom_svg" />


    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/light_grey_disabled_bg_3.1"
        app:layout_constraintEnd_toEndOf="@+id/rl_parent"
        app:layout_constraintStart_toStartOf="@+id/rl_parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_content" />


</androidx.constraintlayout.widget.ConstraintLayout>