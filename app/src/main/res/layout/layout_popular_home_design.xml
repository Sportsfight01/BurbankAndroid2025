<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/ll_parent"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_120dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageView
            android:id="@+id/iv_popular"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@drawable/black_gradient_drawable"
            android:gravity="start"
            android:orientation="horizontal"
            android:padding="@dimen/_3sdp">

            <ImageView
                android:id="@+id/locationIcon"
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:src="@drawable/display_homes_orange"
                android:layout_gravity="center"
                android:layout_centerVertical="true"
                app:tint="@color/white_3.1" />

            <TextView
                android:id="@+id/tv_locations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_5dp"
                android:layout_toEndOf="@+id/locationIcon"
                 android:textAppearance="@style/FontMedium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textAllCaps="true"
                android:textColor="@color/white_3.1"
                android:textSize="@dimen/_12sp"
                tools:text="5 locations" />

        </RelativeLayout>

        <ProgressBar
            android:id="@+id/place_progress"
            android:layout_width="@dimen/_30dp"
            android:layout_height="@dimen/_30dp"
            android:layout_centerInParent="true"
            android:visibility="visible" />


    </RelativeLayout>


    <TextView
        android:id="@+id/tv_carter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        android:text="CARTER"
        android:textAllCaps="true"
        android:textAppearance="@style/FontMedium"
        android:textSize="@dimen/default_text_size"
        android:textColor="@color/grey_text_font_3.1"
        app:layout_constraintTop_toBottomOf="@+id/ll_parent" />

</androidx.constraintlayout.widget.ConstraintLayout>