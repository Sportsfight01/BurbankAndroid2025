<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
       android:layout_marginTop="@dimen/_1dp"
        android:id="@+id/rl_place"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_200"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_house"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/rectangle_test" />

        <ProgressBar
            android:id="@+id/place_progress"
            android:layout_width="@dimen/_30dp"
            android:layout_height="@dimen/_30dp"
            android:layout_centerInParent="true"
            android:visibility="gone" />
    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/rl_content"
        android:layout_marginBottom="@dimen/_5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_10dp"
        android:paddingBottom="@dimen/_5dp"
        android:paddingEnd="@dimen/_10dp"
        android:paddingStart="@dimen/_10dp"
        app:layout_constraintEnd_toEndOf="@+id/rl_place"
        app:layout_constraintStart_toStartOf="@+id/rl_place"
        app:layout_constraintTop_toBottomOf="@+id/rl_place">

        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:textAppearance="@style/FontMedium"
            android:text="All bright estate,Truganina"
            android:textAllCaps="false"
            android:textColor="@color/orange_bg_3.1"
            android:textSize="@dimen/_14sp"
             />

        <TextView
            android:id="@+id/tv_street"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_header"
            android:layout_alignParentStart="true"
            android:layout_marginStart="11dp"
            android:layout_marginTop="0dp"
             android:textAppearance="@style/FontMedium"
            android:text="Poppy street ,Mickleham"
            android:textAllCaps="false"
            android:textColor="@color/box_grey"
            android:textSize="@dimen/_14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_street"
            android:layout_marginTop="@dimen/_8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_design"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/icon_designs"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/tv_designs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_5dp"
                android:textAllCaps="true"
                android:textSize="@dimen/default_text_size"
                android:textAppearance="@style/FontMedium"
                android:textColor="@color/grey_text_font_3.1"
                tools:text="2 Design" />

        </LinearLayout>

        <ImageView
            android:id="@+id/iv_favorite"
            android:layout_width="@dimen/_50dp"
            android:layout_height="@dimen/_50dp"
            android:layout_alignParentEnd="true"
            android:padding="@dimen/_10dp"
            android:src="@drawable/fav_selected"
             />
    </RelativeLayout>
    <View
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_content"
        android:background="@drawable/divider_recyclerview_favorite"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>