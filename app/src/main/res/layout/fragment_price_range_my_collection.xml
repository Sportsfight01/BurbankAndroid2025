<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f6f6f6"
    tools:context=".ui.designs.PriceRangeMyCollectionFragment">

    <include layout="@layout/inclue_tool_design" />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_parent"
        android:paddingStart="24dp"
        android:paddingTop="@dimen/_40dp"
        android:paddingEnd="24dp"
        android:paddingBottom="@dimen/_33dp">

        <TextView
            android:id="@+id/tv_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
           android:textAppearance="@style/FontLight"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:lineSpacingExtra="3sp"
            android:text="WHAT's YOUR PRICE RANGE?"
            android:textAllCaps="true"
            android:textColor="#231f20"
            android:textSize="@dimen/header_text" />

        <LinearLayout
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                android:id="@+id/seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:bar_color="@color/light_grey_disabled_bg_3.1"
                app:bar_highlight_color="@color/grey_text_font_3.1"
                app:corner_radius="10"
                app:data_type="_integer"
                app:left_thumb_color_pressed="#FFFFFF"
                app:left_thumb_image="@drawable/range_seek"
                app:max_value="500"
                app:min_value="100"
                app:right_thumb_color="#FFFFFF"
                app:right_thumb_color_pressed="#FFFFFF"
                app:right_thumb_image="@drawable/range_seek" />

            <TextView
                android:id="@+id/tv_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
               android:textAppearance="@style/FontLight"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:lineSpacingExtra="4sp"
                android:text="$390K to $480K"
                android:textColor="#5c5e5e"
                android:textSize="20sp" />

            <LinearLayout
                android:id="@+id/ll_bar"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:weightSum="7">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center|top"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bar_lines"
                    android:backgroundTint="#fee2c8"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="3"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center|top"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bar_lines"
                    android:backgroundTint="#fdc997"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="4"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center|top"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bar_lines"
                    android:backgroundTint="#faa658"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="2"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center|top"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bar_lines"
                    android:backgroundTint="#f68b1f"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="8"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center|top"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bar_lines"
                    android:backgroundTint="#faa658"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="6"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center|top"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bar_lines"
                    android:backgroundTint="#fdc997"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="5"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center|top"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bar_lines"
                    android:backgroundTint="#fee2c8"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="4"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="4">

                <TextView
                    android:id="@+id/tv_continue"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_marginRight="5dp"
                    android:layout_weight="2"
                    android:background="@drawable/rectangel_skip"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="center"
                    android:text="Continue"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_marginLeft="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/rectangel_skip"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="center"
                    android:text="Skip"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_designs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/bottom_next"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="@dimen/_20dp"
           android:textAppearance="@style/FontRegular"
            android:lineSpacingExtra="2sp"
            android:text="SKIP &gt;"
            android:textColor="#d1d3d4"
            android:textSize="18sp"
            android:visibility="invisible" />

        <include
            android:id="@+id/bottom_next"
            layout="@layout/layout_bottom_next_previous"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60dp"
            android:layout_alignParentBottom="true" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone" />

    </RelativeLayout>

</RelativeLayout>