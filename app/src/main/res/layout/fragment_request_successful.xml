<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.mydisplay.nearby.RequestSuccessfulFragment">

    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_8dp">

        <ImageView
            android:id="@+id/iv_success"
            android:layout_width="@dimen/_30dp"
            android:layout_height="@dimen/_30dp"
            android:layout_centerVertical="true"
            android:src="@drawable/sucess"
            app:tint="@color/greenEnd" />

        <TextView
            android:id="@+id/tv_choose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_5dp"
            android:layout_toEndOf="@+id/iv_success"
             android:textAppearance="@style/FontMedium"
            android:gravity="center"
            android:text="Request Successful"
            android:textAllCaps="true"
            android:textColor="@color/grey_text_font_3.1"
            android:textSize="@dimen/_16sp" />

        <LinearLayout
            android:id="@+id/ll_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_gravity="end"
            android:background="@drawable/round_with_white_bg"
            android:gravity="center"
            android:paddingStart="@dimen/_1dp"
            android:paddingTop="@dimen/_1dp"
            android:paddingEnd="@dimen/_1dp"
            android:paddingBottom="@dimen/_1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X"
                android:gravity="center"
                android:layout_gravity="center"
                android:textSize="16sp"
                android:textColor="@color/orange_bg_3.1"
                 />
        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/ll_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_header"
        android:background="@color/enabled_orange_bg_3.1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/_30dp"
        android:paddingTop="@dimen/_20dp"
        android:paddingEnd="@dimen/_10dp"
        android:paddingBottom="@dimen/_20dp">

        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/_10dp"
             android:textAppearance="@style/FontMedium"
            android:text="Botanical estate"
            android:layout_centerHorizontal="true"
            android:textAllCaps="true"
            android:textColor="@color/white_3.1"
            android:textSize="@dimen/_16sp" />

        <TextView
            android:id="@+id/tv_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_header"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/_10dp"
            android:textAppearance="@style/FontMedium"
            tools:text="Tuesday,March 3"
            android:gravity="center"
            android:layout_centerHorizontal="true"
            android:textAllCaps="false"
            android:textColor="@color/white_3.1"
            android:textSize="@dimen/_14sp" />

        <TextView
            android:id="@+id/tv_morning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_day"
            android:layout_alignParentStart="true"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginBottom="@dimen/_10dp"
            android:layout_centerHorizontal="true"
             android:textAppearance="@style/FontMedium"
            android:text="Morning"
            android:textAllCaps="true"
            android:textColor="@color/white_3.1"
            android:textSize="@dimen/_12sp"
            />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_we_will"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ll_container"
        android:layout_marginStart="@dimen/_5dp"
        android:layout_marginTop="@dimen/_16dp"
         android:textAppearance="@style/FontMedium"
        android:paddingStart="@dimen/_30dp"
        android:paddingEnd="@dimen/_30dp"
        android:text="Thank you for your appointment request. A New Home Consultant will be in touch with your precise appointment time."
        android:textAllCaps="false"
        android:textColor="@color/grey_text_font_3.1"
        android:textSize="@dimen/_16sp" />


</RelativeLayout>