 <RelativeLayout
     android:id="@+id/rl_header"
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
     android:background="@color/app_bg"
     android:paddingStart="20dp"
     android:paddingTop="2dp"
     android:paddingEnd="2dp"
     android:layout_alignParentTop="true"
     android:paddingBottom="@dimen/_10dp"
     app:layout_constraintEnd_toEndOf="parent"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintTop_toTopOf="parent">

  <ImageView
      android:id="@+id/iv_back"
      android:layout_width="@dimen/back_icon_height_width"
      android:layout_height="@dimen/back_icon_height_width"
      android:layout_alignParentStart="true"
      android:layout_centerVertical="true"
      android:src="@drawable/back_png_grey"
      android:tint="@color/black_bg_3.1"
      />


  <LinearLayout
      android:id="@+id/ll_header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_toEndOf="@+id/iv_back"
      android:orientation="horizontal"
      android:layout_centerVertical="true"
      android:padding="@dimen/_10dp">

   <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:textAppearance="@style/FontRegular"
       android:includeFontPadding="false"
       android:lineSpacingExtra="0sp"
       android:text="Enquire"
       android:textColor="@color/grey_text_font_3.1"
       android:textSize="@dimen/header_size" />

   <TextView
       android:id="@+id/tv_header_desc"
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:textAppearance="@style/FontMedium"
       android:lineSpacingExtra="0sp"
       android:paddingStart="0dp"
       android:text="@string/now"
       android:textColor="@color/grey_text_font_3.1"
       android:textSize="@dimen/header_size" />

  </LinearLayout>
  <ImageView
      android:id="@+id/iv_profile"
      android:layout_width="@dimen/profile_pic"
      android:layout_height="@dimen/profile_pic"
      android:layout_alignParentEnd="true"
      android:layout_centerVertical="true"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="@dimen/_10sdp"
      android:src="@mipmap/logo_myplace"
      app:civ_border_width="0dp" />
 </RelativeLayout>
 <View
     android:layout_width="match_parent"
     android:layout_height="1dp"
     android:background="@color/black_bg_3.1"
     android:id="@+id/line"
     android:layout_below="@+id/rl_header"/>

 <androidx.constraintlayout.widget.ConstraintLayout
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:orientation="vertical"
     android:layout_below="@+id/line"
    >
 <WebView
     android:id="@+id/webView"
     android:layout_width="match_parent"
     android:layout_height="match_parent"
     android:layout_marginTop="-30dp"
     android:background="@color/app_bg"/>
 </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>