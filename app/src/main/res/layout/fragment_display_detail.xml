<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/body_bg_3.1"
    tools:context=".ui.mydisplay.DisplayDetailFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/body_bg_3.1"
        app:layout_constraintBottom_toTopOf="@+id/ll_container">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:id="@+id/ll_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40dp"
                android:background="@color/enabled_orange_bg_3.1"
                android:gravity="start"
                android:orientation="vertical"
                >

                <LinearLayout
                    android:id="@+id/ll_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="end"
                    android:background="@drawable/round_line"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:layout_marginEnd="@dimen/_10dp"
                    android:paddingTop="@dimen/_3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="@dimen/_3dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontMedium"
                        android:gravity="center"
                        android:text="Back"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:textColor="@color/orange_bg_3.1" />

                    <ImageView
                        android:id="@+id/iv_back"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/back_png_grey"
                        app:tint="@color/orange_bg_3.1" />
                </LinearLayout>
            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#e6e7e8" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible">

                <include layout="@layout/list_collection_item" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_350dp"
                android:layout_gravity="center"
                android:background="@color/white"
                android:orientation="vertical">

                <com.github.chrisbanes.photoview.PhotoView
                    android:id="@+id/iv_floorpaln"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/floorplanLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="center"
                    android:text="@string/floor_plan_loading"
                    android:textColor="@color/box_grey"
                    android:textSize="@dimen/_20sp"
                    android:visibility="visible" />


            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50dp"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:weightSum="2">

                <!--<LinearLayout
                    android:id="@+id/ll_myplace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/_5dp"
                    android:layout_weight="0.8"
                    android:background="@drawable/homex_icon"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/_10dp" />-->
                <LinearLayout
                    android:id="@+id/ll_myplace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_5dp"
                    android:layout_weight="1"
                    android:background="@drawable/rectangle_grey"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/_10dp"
                    android:paddingRight="@dimen/_10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontRegular"
                        android:includeFontPadding="false"
                        android:text="@string/virtual"
                        android:textColor="@color/white_3.1"
                        android:gravity="center"
                        android:textSize="@dimen/_18dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontExtraBold"
                        android:includeFontPadding="false"
                        android:text="@string/home_tour"
                        android:textColor="@color/white_3.1"
                        android:textSize="@dimen/_16sp"
                        android:visibility="visible" />

                    <ImageView
                        android:layout_width="@dimen/_30dp"
                        android:layout_height="@dimen/_30dp"
                        android:layout_marginStart="@dimen/_10dp"
                        android:src="@drawable/icon_home_land_threed"
                        android:visibility="gone"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_homeland"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_5dp"
                    android:layout_weight="1.0"
                    android:background="@drawable/rectangle_grey"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/_10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontExtraBold"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="6sp"
                        android:text="@string/house"
                        android:textColor="@color/white_3.1"
                        android:textSize="@dimen/_18sp"
                        android:visibility="visible" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontRegular"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="6sp"
                        android:text="@string/and_symbol"
                        android:textColor="@color/white_3.1"
                        android:textSize="@dimen/_18sp"
                        android:visibility="visible" />


                    <TextView
                        android:id="@+id/tv_header_desc_land"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontExtraBold"
                        android:includeFontPadding="false"
                        android:text="@string/land"
                        android:textColor="@color/white_3.1"
                        android:textSize="@dimen/_18sp" />

                    <ImageView
                        android:layout_width="@dimen/_30dp"
                        android:layout_height="@dimen/_30dp"
                        android:layout_marginStart="@dimen/_10dp"
                        android:src="@drawable/icon_home_land_threed"
                        android:visibility="gone"/>


                </LinearLayout>

            </LinearLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="@dimen/_16dp">

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="20dp" />

                <com.tbuonomo.viewpagerdotsindicator.SpringDotsIndicator
                    android:id="@+id/dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|bottom"
                    android:layout_marginBottom="15dp"
                    app:dotsColor="@color/orange_bg_3.1"
                    app:dotsCornerRadius="8dp"
                    app:dotsSize="8dp"
                    app:dotsSpacing="4dp"
                    app:dotsWidthFactor="2.5"
                    app:progressMode="true"
                    app:dotsStrokeColor="@color/white_3.1"
                    app:selectedDotColor="@color/orange_bg_3.1" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvFacade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_10dp"
                android:layout_marginBottom="@dimen/_10dp"
                 android:textAppearance="@style/FontRegular"
                android:textColor="@color/black_bg_3.1"
                android:inputType="textCapSentences"
                android:textSize="@dimen/_16sp"
                tools:text="@string/app_name" />

            <RelativeLayout
                android:id="@+id/rl_enquiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#f6f6f6"
                android:paddingTop="@dimen/_10dp"
                android:paddingBottom="@dimen/_10dp">

                <Button
                    android:id="@+id/enquiry"
                    android:layout_width="300dp"
                    android:layout_height="45dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="@dimen/_10dp"
                    android:background="@drawable/rectangle_orange_bg"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="ENQUIRE"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    />

                <TextView
                    android:id="@+id/savedesign"
                    android:layout_width="300dp"
                    android:layout_height="45dp"
                    android:layout_below="@+id/enquiry"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/rectangel_black"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="center"
                    android:paddingStart="@dimen/_8dp"
                    android:paddingEnd="@dimen/_8dp"
                    android:text="SAVE DESIGN"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    />
            </RelativeLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>