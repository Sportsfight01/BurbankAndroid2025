<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/cl_layout"
    android:background="@color/body_bg_3.1"
    tools:context=".ui.designs.MycollectionDetailsFragment">

    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/body_bg_3.1"
        android:paddingBottom="@dimen/_2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/inclue_tool_designid"
            layout="@layout/inclue_tool_design" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_header_old"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/body_bg_3.1"
        android:paddingStart="16dp"
        android:paddingEnd="10dp"
        android:visibility="gone"
        android:paddingBottom="@dimen/_20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentTop="true"
            android:src="@drawable/icon_back_navigation"
            />

        <RelativeLayout
            android:id="@+id/rl_tool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/iv_back"
            android:layout_alignBottom="@+id/iv_back"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_toEndOf="@+id/iv_back"
            android:gravity="start|center">

            <TextView
                android:id="@+id/tv_tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:ellipsize="end"
                android:gravity="center|start"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/app_name"
                android:textColor="@color/dark_grey"
                android:textSize="16sp"
                android:textAppearance="@style/FontMedium"
                android:visibility="visible" />
        </RelativeLayout>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/nested_scroll"
        android:background="@color/body_bg_3.1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/ll_sub_header"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:visibility="visible">

                <include layout="@layout/list_collection_item" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#e6e7e8" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_350dp"
                android:id="@+id/rl_floorlayout"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:orientation="vertical">
               <ImageView
                    android:id="@+id/body_previous"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/icon_back_navigation"
                    android:layout_centerVertical="true"
                    android:visibility="visible"
                   android:tint="@color/grey_text_font_3.1"
                   android:layout_marginStart="@dimen/_10dp"
                   android:layout_marginEnd="@dimen/_2dp"
                   />
                <com.github.chrisbanes.photoview.PhotoView
                    android:id="@+id/iv_floorpaln"
                    android:layout_width="match_parent"
                    android:layout_toRightOf="@+id/body_previous"
                    android:layout_toLeftOf="@+id/body_next"
                    android:background="@color/body_bg_3.1"
                    android:layout_height="match_parent"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/floorplanLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="center"
                    android:text="@string/floor_plan_loading"
                    android:textColor="@color/grey_text_font_3.1"
                    android:textSize="@dimen/_20sp"
                    android:visibility="visible" />

               <ImageView
                    android:id="@+id/body_next"
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/icon_back_navigation"
                    android:visibility="visible"
                   android:tint="@color/grey_text_font_3.1"
                    android:layout_alignParentRight="true"
                    android:layout_toRightOf="@+id/iv_like"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_2dp"
                   android:layout_marginEnd="@dimen/_10dp"
                    android:rotation="180"
                    />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50dp"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:weightSum="2">

               <!-- <LinearLayout
                    android:id="@+id/ll_myplace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/_5dp"
                    android:layout_weight="0.7"
                    android:background="@drawable/homex_icon"
                    android:gravity="center"
                    android:orientation="horizontal" />-->
                <LinearLayout
                    android:id="@+id/ll_myplace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_5dp"
                    android:layout_weight="1"
                    android:background="@drawable/rectangle_grey"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/_10dp"
                    android:paddingRight="@dimen/_10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontRegular"
                        android:includeFontPadding="false"
                        android:text="@string/virtual"
                        android:textColor="@color/white_3.1"
                        android:gravity="center"
                        android:textSize="@dimen/_18dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontMedium"
                        android:includeFontPadding="false"
                        android:text="@string/home_tour"
                        android:textColor="@color/white_3.1"
                        android:textSize="@dimen/_16dp"
                        android:visibility="visible" />

                    <ImageView
                        android:layout_width="@dimen/_30dp"
                        android:layout_height="@dimen/_30dp"
                        android:layout_marginStart="@dimen/_10dp"
                        android:src="@drawable/icon_home_land_threed"
                        android:visibility="gone"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/ll_homeland"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_5dp"
                    android:layout_weight="1"
                    android:background="@drawable/rectangle_grey"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/_10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontMedium"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="6sp"
                        android:text="@string/house"
                        android:textColor="@color/white_3.1"
                        android:textSize="@dimen/_16sp"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_header_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontRegular"
                        android:includeFontPadding="false"
                        android:text="&amp;"
                        android:textColor="@color/white_3.1"
                        android:textSize="@dimen/_18dp" />
                    <TextView
                        android:id="@+id/tv_Land"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontMedium"
                        android:includeFontPadding="false"
                        android:text="@string/land"
                        android:textColor="@color/white_3.1"
                        android:textSize="@dimen/_18dp" />

                    <ImageView
                        android:layout_width="@dimen/_30dp"
                        android:layout_height="@dimen/_30dp"
                        android:layout_marginStart="@dimen/_10dp"
                        android:src="@drawable/icon_home_land_threed"
                        android:visibility="gone"/>
                </LinearLayout>

            </LinearLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/body_bg_3.1"
                android:layout_marginTop="@dimen/_16dp">

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="20dp" />

             <!--   <com.tbuonomo.viewpagerdotsindicator.SpringDotsIndicator
                    android:id="@+id/dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|bottom"
                    android:layout_marginBottom="15dp"
                    app:dotsColor="@color/orange_bg_3.1"
                    app:dotsStrokeColor="@color/white_3.1"
                    app:dotsCornerRadius="8dp"
                    app:dotsSize="8dp"
                    app:dotsSpacing="4dp"
                    app:dotsWidthFactor="2.5"
                    app:progressMode="true"
                    app:selectedDotColor="@color/orange_bg_3.1" />
-->
            </FrameLayout>

            <TextView
                android:id="@+id/tvFacade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_10dp"
                android:layout_marginBottom="@dimen/_10dp"
                 android:textAppearance="@style/FontRegular"
                android:textColor="@color/black_bg_3.1"
                android:inputType="textCapSentences"
                android:textSize="@dimen/_16sp"
                tools:text="@string/app_name" />

            <RelativeLayout
                android:id="@+id/rl_enquiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:background="#f6f6f6"
                android:paddingTop="@dimen/_10dp"
                android:paddingBottom="@dimen/_200sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <Button
                    android:id="@+id/enquiry"
                    android:layout_width="300dp"
                    android:layout_height="45dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="@dimen/_10dp"
                    android:background="@drawable/rectangle_orange_bg"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="ENQUIRE"
                    android:textColor="@color/white_3.1"
                    android:textSize="14sp"
                  />

                <TextView
                    android:id="@+id/savedesign"
                    android:layout_width="300dp"
                    android:layout_height="45dp"
                    android:layout_marginBottom="5dp"
                    android:layout_below="@+id/enquiry"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/rectangle_orange_bg"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="center"
                    android:visibility="visible"
                    android:paddingStart="@dimen/_8dp"
                    android:paddingEnd="@dimen/_8dp"
                    android:text="SAVE DESIGN"
                    android:textColor="@color/white_3.1"
                    android:textSize="14sp"
                    />
            </RelativeLayout>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>