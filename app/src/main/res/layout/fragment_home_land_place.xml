<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/body_bg_3.1"
    tools:context=".ui.homeandlandplaces.HomeLandPlaceFragment">

    <RelativeLayout
        android:id="@+id/rl_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_bg">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/back_icon_height_width"
            android:layout_height="@dimen/back_icon_height_width"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/_10dp"
            android:src="@drawable/back_png_grey"
            app:tint="@color/black_bg_3.1" />

        <TextView
            android:id="@+id/tv_tool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/iv_back"
            android:layout_toEndOf="@+id/iv_back"
            android:textAppearance="@style/FontMedium"
            android:gravity="start|center"
            android:paddingTop="@dimen/_5dp"
            android:paddingBottom="@dimen/_5dp"
            android:textColor="@color/grey_text_font_3.1"
            android:textSize="@dimen/sub_header_size"
            tools:text="North | Single | 4+ Beds | $420k - $550k " />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_tool"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:gravity="center">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerInParent="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="1dp"

                android:orientation="horizontal"
                >
            <TextView
                android:id="@+id/tv_sort_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="35dp"
                android:background="@drawable/rectangle_orange_bg"
                android:textAppearance="@style/FontMedium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="@dimen/_15dp"
                android:text="SORT / FILTER"
                android:textColor="@color/white"
                android:textSize="13sp"
                />

            <TextView
                android:id="@+id/tv_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_toRightOf="@+id/tv_sort_filter"
                android:background="@drawable/rectangle_orange_bg"
                android:textAppearance="@style/FontMedium"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:layout_marginTop="@dimen/_15dp"

                android:paddingBottom="6dp"
                android:textAllCaps="true"
                android:text="MAP"
                android:textColor="@color/white"
                android:textSize="13sp"
                />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="1dp"
                android:layout_marginLeft="@dimen/_5dp"
                android:gravity="center"
                >

                <include layout="@layout/profile_with_badge" />
            </LinearLayout>


         <!--   <TextView
                android:id="@+id/tv_favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_tool"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:layout_marginTop="@dimen/_15dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/rectangle_light_orange"
                android:gravity="center|end"
                android:paddingLeft="15dp"
                android:paddingTop="5dp"
                android:paddingRight="15dp"
                android:paddingBottom="5dp"
               android:textAppearance="@style/FontMedium"
                android:text="@string/myprofile"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="13sp"
                a/>
            <TextView
                android:id="@+id/profile_notification"
                android:layout_width="@dimen/_18sp"
                android:layout_height="@dimen/_18sp"
                android:layout_below="@+id/rl_tool"
                android:layout_alignParentEnd="true"
                android:background="@drawable/black_round"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="0"
                android:textSize="@dimen/_7sdp"
                android:textColor="@color/white" />-->

        </RelativeLayout>


    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/fav_header"
        android:background="@color/white_3.1"
        android:paddingTop="@dimen/_5dp"
        android:paddingLeft="@dimen/_10sp"

        android:layout_below="@+id/rl_top"
        android:paddingBottom="@dimen/_5dp">

        <ImageView
            android:id="@+id/iv_home_design"
            android:layout_width="@dimen/favourite_indicate_width_height"
            android:layout_height="@dimen/favourite_indicate_width_height"
            android:layout_gravity="center"
            android:layout_marginStart="2dp"
            android:layout_toEndOf="@+id/iv_homedesign_notification"
            android:src="@drawable/homeland_bottom_svg"
            app:tint="@color/grey_text_font_3.1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_gravity="center"
            android:layout_toEndOf="@+id/iv_home_design"
             android:textAppearance="@style/FontMedium"
            android:text="House &amp; Land"
            android:textColor="@color/grey_text_font_3.1"
            android:textSize="@dimen/_18sp" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_places"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/fav_header"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="15"
        android:visibility="gone"
        tools:listitem="@layout/list_item_place" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_favorites"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/fav_header"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:itemCount="15"
        tools:listitem="@layout/list_item_place" />


    <ProgressBar
        android:id="@+id/progress_places"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_no_favorites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textColor="@color/dark_grey_bg_3.1"
         android:textAppearance="@style/FontMedium"
        android:gravity="center"
        android:paddingTop="@dimen/_10sp"
        android:paddingBottom="@dimen/_10sp"
        android:text="No Favourites Packages found"
        android:textSize="@dimen/_20sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black_bg_3.1"
        android:layout_below="@+id/fav_header"/>

</RelativeLayout>