<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/body_bg_3.1"
    android:paddingBottom="@dimen/_15dp"
    tools:context=".ui.mydisplay.nearby.NearbyBottomSheetFragment">


    <RelativeLayout
        android:id="@+id/ll_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/enabled_orange_bg_3.1"
        android:gravity="start"
        android:orientation="vertical"
        android:paddingStart="@dimen/_10dp"
        android:paddingEnd="@dimen/_10dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_estateName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_gravity="start"
            android:layout_marginTop="@dimen/_10dp"
             android:textAppearance="@style/FontMedium"
            android:gravity="start"
            android:text="Botanical estate"
            android:textAllCaps="true"
            android:textColor="@color/white_3.1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_street_subrub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_estateName"
            android:layout_alignParentStart="true"
            android:layout_gravity="start"
            android:layout_marginBottom="@dimen/_10dp"
             android:textAppearance="@style/FontMedium"
            android:text="Poppy Street, Mickleham"
            android:textAllCaps="false"
            android:textColor="@color/white_3.1"
            android:visibility="invisible" />

        <RelativeLayout
            android:id="@+id/rl_top_bar"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/_10dp"
            android:paddingBottom="@dimen/_10dp">

            <TextView
                android:id="@+id/tv_estateName2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/_10dp"
                android:layout_toStartOf="@+id/tv_street_subrub2"
                 android:textAppearance="@style/FontMedium"
                android:text="Botanical estate"
                android:textAllCaps="true"
                android:textSize="@dimen/default_text_size"
                android:textColor="@color/white_3.1"
                android:visibility="visible" />

            <TextView
                android:id="@+id/tv_street_subrub2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                 android:textAppearance="@style/FontMedium"
                android:gravity="right"
                android:text="Poppy Street,\nMickleham"
                android:textSize="@dimen/default_text_size"
                android:textAllCaps="false"
                android:textColor="@color/white_3.1"
                android:visibility="visible" />
        </RelativeLayout>


        <LinearLayout
            android:id="@+id/ll_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_gravity="end"
            android:background="@drawable/round_line"
            android:gravity="center"
            android:paddingStart="12dp"
            android:layout_marginEnd="@dimen/_3dp"
            android:paddingTop="@dimen/_3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="@dimen/_3dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:textAppearance="@style/FontMedium"
                android:gravity="center"
                android:text="Back"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/orange_bg_3.1" />

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/back_png_grey"
                app:tint="@color/orange_bg_3.1" />
        </LinearLayout>
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_container"
        tools:itemCount="2"
        tools:listitem="@layout/layout_nearby_list_item" />

    <RelativeLayout
        android:id="@+id/ll_trading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10dp"
        android:layout_marginTop="@dimen/_10dp"
        android:layout_marginEnd="@dimen/_10dp"
        android:background="@drawable/rectangle_disable_button"
        android:orientation="vertical"
        android:paddingStart="@dimen/_15dp"
        android:paddingTop="@dimen/_10dp"
        android:paddingEnd="@dimen/_15dp"
        android:paddingBottom="@dimen/_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recycler_view">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:textAppearance="@style/FontMedium"
            android:id="@+id/tv_TRADING_HOURS"
            android:text="TRADING HOURS"
            android:textColor="@color/grey_text_font_3.1"
            android:textSize="@dimen/_13sp" />

        <TextView
            android:id="@+id/tv_trading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:textAppearance="@style/FontMedium"
            android:text="Mon: 12pm - 5pm | Tue - Wed: 11am - 5pm"
            android:layout_below="@+id/tv_TRADING_HOURS"
            android:textColor="@color/grey_text_font_3.1"
            android:singleLine="true"
            android:textSize="@dimen/_12sp" />

        <ImageView
            android:id="@+id/down_arrow"
            android:layout_width="@dimen/_16dp"
            android:layout_height="@dimen/_16dp"
            android:layout_alignParentRight="true"
            android:rotation="270"
            android:src="@drawable/back_png_grey"
            app:tint="@color/black" />


    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_trading">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_direction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rectangle_orange_bg"
                 android:textAppearance="@style/FontMedium"
                android:paddingStart="@dimen/_10dp"
                android:paddingTop="@dimen/_8dp"
                android:paddingEnd="@dimen/_10dp"
                android:paddingBottom="@dimen/_8dp"
                android:text="@string/get_directions"
                android:textColor="@color/white"
                android:textSize="@dimen/_13sp"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_book_appointment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10dp"
                android:background="@drawable/rectangle_orange_bg"
                 android:textAppearance="@style/FontMedium"
                android:paddingStart="@dimen/_10dp"
                android:paddingTop="@dimen/_8dp"
                android:paddingEnd="@dimen/_10dp"
                android:paddingBottom="@dimen/_8dp"
                android:text="@string/book_an_appointment"
                android:textColor="@color/white"
                android:textSize="@dimen/_13sp"
                app:layout_constraintTop_toTopOf="parent" />

        </LinearLayout>


    </RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>