<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/body_bg_3.1"
    tools:context=".ui.mydisplay.favoritesDisplays.FavoriteDisplayDetailFragment">

    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/app_bg"
        android:paddingStart="16dp"

        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/back_icon_height_width"
                android:layout_height="@dimen/back_icon_height_width"
                android:layout_alignParentTop="true"
                android:src="@drawable/back_png_grey"
                app:tint="@color/black_bg_3.1" />

            <RelativeLayout
                android:id="@+id/rl_tool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/iv_back"
                android:layout_marginTop="@dimen/_5dp"
                android:layout_toEndOf="@+id/iv_back"
                android:gravity="start|center">

                <TextView
                    android:id="@+id/tv_tool"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center"
                    android:ellipsize="end"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="center|start"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textAllCaps="false"
                    android:text="@string/take_a_quick_survey_to_find_your_perfect_design"
                    android:textColor="@color/grey_text_font_3.1"
                    android:textSize="16sp"
                    android:visibility="visible" />
            </RelativeLayout>


            <TextView
                android:id="@+id/tv_how_does_it"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_tool"
                android:layout_alignStart="@+id/rl_tool"
                android:layout_marginTop="@dimen/_15dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rectangel_line"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:textAppearance="@style/FontMedium"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:text="@string/how_does_it_work"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tv_favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_tool"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/_15dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rectangel_line"
                android:gravity="end"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:visibility="invisible"
                android:text="@string/favourites"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textAppearance="@style/FontMedium"
                />


     <!--   <ImageView
            android:id="@+id/iv_back"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentTop="true"
            android:rotation="180"
            android:src="@drawable/side_arrow" />

        <RelativeLayout
            android:id="@+id/rl_tool"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/iv_back"
            android:layout_alignBottom="@+id/iv_back"
            android:layout_marginStart="@dimen/_16dp"
            android:layout_toEndOf="@+id/iv_back"
            android:gravity="start|center">

            <TextView
                android:id="@+id/tv_tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:ellipsize="end"
                android:gravity="center|start"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text="@string/app_name"
                android:textColor="#ffffff"
                android:textSize="16sp"
                 android:textAppearance="@style/FontMedium"
                android:visibility="visible" />
        </RelativeLayout>-->
    </RelativeLayout>

    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black_bg_3.1"
        app:layout_constraintTop_toBottomOf="@+id/rl_header"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/body_bg_3.1"
        android:layout_marginTop="@dimen/_80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/line">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/body_bg_3.1"
                android:layout_marginTop="-12dp"
                android:visibility="visible">

                <include layout="@layout/list_collection_item" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/light_grey_disabled_bg_3.1" />
            <RelativeLayout
                android:id="@+id/ll_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/appColor"
                android:gravity="start"
                android:visibility="gone"
                android:orientation="vertical"
                >

                <LinearLayout
                    android:id="@+id/ll_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/_5dp"
                    android:layout_marginBottom="@dimen/_5dp"
                    android:background="@drawable/round_line"
                    android:gravity="center"
                    android:paddingStart="@dimen/_15dp"
                    android:paddingTop="@dimen/_8dp"
                    android:paddingEnd="@dimen/_15dp"
                    android:paddingBottom="@dimen/_8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/_5dp"
                         android:textAppearance="@style/FontMedium"
                        android:gravity="center"
                        android:text="Back"
                        android:textAllCaps="false"
                        android:textColor="@color/black" />

                    <ImageView
                        android:layout_width="@dimen/_20dp"
                        android:layout_height="@dimen/_20dp"
                        android:src="@drawable/back_arrow"
                        app:tint="@color/white" />
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_350dp"
                android:layout_gravity="center"
                android:background="@color/white_3.1"
                android:orientation="vertical">

                <com.github.chrisbanes.photoview.PhotoView
                    android:id="@+id/iv_floorpaln"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/floorplanLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="center"
                    android:text="@string/floor_plan_loading"
                    android:textColor="@color/box_grey"
                    android:textSize="@dimen/_20sp"
                    android:visibility="visible" />


            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50dp"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:background="@color/body_bg_3.1"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:weightSum="2">

                <!--<LinearLayout
                    android:id="@+id/ll_myplace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/_5dp"
                    android:layout_weight="0.8"
                    android:background="@drawable/homex_icon"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/_10dp" />-->
                <LinearLayout
                    android:id="@+id/ll_myplace"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_5dp"
                    android:layout_weight="1"
                    android:background="@drawable/rectangle_grey"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/_10dp"
                    android:paddingRight="@dimen/_10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontRegular"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/virtual"
                        android:textColor="@color/white_3.1"
                        android:textSize="@dimen/_18dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontExtraBold"
                        android:includeFontPadding="false"
                        android:text="@string/home_tour"
                        android:textColor="@color/white_3.1"
                        android:textSize="@dimen/_16sp"
                        android:visibility="visible" />

                    <ImageView
                        android:layout_width="@dimen/_30dp"
                        android:layout_height="@dimen/_30dp"
                        android:layout_marginStart="@dimen/_10dp"
                        android:src="@drawable/icon_home_land_threed"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_homeland"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/_5dp"
                    android:layout_weight="1.0"
                    android:background="@drawable/rectangle_grey"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/_10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontExtraBold"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="6sp"
                        android:text="@string/house"
                        android:textColor="@color/white_3.1"
                        android:textSize="@dimen/_18sp"
                        android:visibility="visible" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontRegular"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="6sp"
                        android:text="@string/and_symbol"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_18sp"
                        android:visibility="visible" />
                    <TextView
                        android:id="@+id/tv_header_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                         android:textAppearance="@style/FontExtraBold"
                        android:includeFontPadding="false"
                        android:text="@string/land"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_18sp" />

                    <ImageView
                        android:layout_width="@dimen/_30dp"
                        android:layout_height="@dimen/_30dp"
                        android:layout_marginStart="@dimen/_10dp"
                        android:src="@drawable/icon_home_land_threed"
                        android:visibility="gone" />


                </LinearLayout>

            </LinearLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/body_bg_3.1"
                android:layout_marginTop="@dimen/_16dp">

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="20dp" />

              <!--  <com.tbuonomo.viewpagerdotsindicator.SpringDotsIndicator
                    android:id="@+id/dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|bottom"
                    android:layout_marginBottom="15dp"
                    app:dotsColor="@color/orange_bg_3.1"
                    app:dotsStrokeColor="@color/white_3.1"
                    app:dotsCornerRadius="8dp"
                    app:dotsSize="8dp"
                    app:dotsSpacing="4dp"
                    app:dotsWidthFactor="2.5"
                    app:progressMode="true"
                    app:selectedDotColor="@color/orange_bg_3.1" />-->
                <LinearLayout
                    android:id="@+id/dotsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center|bottom"
                    android:padding="4dp"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvFacade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_10dp"
                android:layout_marginBottom="@dimen/_10dp"
                 android:textAppearance="@style/FontRegular"
                android:textColor="@color/black"
                android:inputType="textCapSentences"
                android:textSize="@dimen/_16sp"
                tools:text="@string/app_name" />

            <RelativeLayout
                android:id="@+id/rl_enquiry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#f6f6f6"
                android:paddingTop="@dimen/_10dp"
                android:paddingBottom="@dimen/_10dp">

                <Button
                    android:id="@+id/enquiry"
                    android:layout_width="300dp"
                    android:layout_height="45dp"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="@dimen/_10dp"
                    android:background="@drawable/rectangel_skip"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="ENQUIRE"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                   />

                <TextView
                    android:id="@+id/savedesign"
                    android:layout_width="300dp"
                    android:layout_height="45dp"
                    android:layout_below="@+id/enquiry"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/rectangle_charcoal_bg"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="center"
                    android:paddingStart="@dimen/_8dp"
                    android:paddingEnd="@dimen/_8dp"
                    android:text="SAVE DESIGN"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                     />
            </RelativeLayout>
        </LinearLayout>


    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>