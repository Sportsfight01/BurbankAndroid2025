<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.60" />


    <RelativeLayout
        android:id="@+id/rl_first"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:id="@+id/rl_place"
            android:layout_width="@dimen/_80dp"
            android:layout_height="@dimen/_50dp">

            <ImageView
                android:id="@+id/iv_place"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/rectangle_test" />

            <ProgressBar
                android:id="@+id/place_progress"
                android:layout_width="@dimen/_30dp"
                android:layout_height="@dimen/_30dp"
                android:layout_centerInParent="true"
                android:visibility="gone" />
        </RelativeLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/rl_place"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:textAppearance="@style/FontMedium"
                android:text="Mendelsohn"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="16sp"
               />

            <TextView
                android:id="@+id/tv_locations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textAllCaps="true"
                 android:textAppearance="@style/FontMedium"
                android:text="6 Locations"
                android:textColor="@color/orange_bg_3.1"
                android:textSize="14sp"
                 />
        </LinearLayout>


    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_second"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@+id/rl_first"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@+id/rl_first"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:id="@+id/rl_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_bedrooms"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="3dp"
                android:layout_marginEnd="5dp"
                android:layout_marginRight="3dp"
                android:src="@drawable/third_eminities" />

            <TextView
                android:id="@+id/tv_bed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_toEndOf="@+id/iv_bedrooms"
                 android:textAppearance="@style/FontMedium"
                android:text="4"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="12sp" />


            <ImageView
                android:id="@+id/iv_bathrooms"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginStart="@dimen/_15dp"
                android:layout_marginLeft="3dp"
                android:layout_marginEnd="5dp"
                android:layout_marginRight="3dp"
                android:layout_toEndOf="@+id/iv_bedrooms"
                android:layout_toRightOf="@+id/iv_bedrooms"
                android:src="@drawable/bath_eminities" />

            <TextView
                android:id="@+id/tv_bath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_toEndOf="@+id/iv_bathrooms"
                 android:textAppearance="@style/FontMedium"
                android:text="2"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="12sp" />


            <ImageView
                android:id="@+id/iv_car"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginStart="@dimen/_15dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_toEndOf="@+id/iv_bathrooms"
                android:src="@drawable/car_eminities" />

            <TextView
                android:id="@+id/tvcar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@+id/iv_car"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/_5dp"
                android:layout_toEndOf="@+id/iv_car"
                 android:textAppearance="@style/FontMedium"
                android:text="2"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="12sp" />


        </RelativeLayout>

    </RelativeLayout>

    <com.dmss.burbankapp.utility.ExpandableLayout
        android:id="@+id/el_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10dp"
        app:el_expanded="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_first">


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_sublist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rl_first"
            tools:itemCount="5"
            tools:listitem="@layout/layout_expand_sub_list" />


        <View
            android:layout_width="match_parent"
            android:layout_height="0.7dp"
            android:background="@color/light_grey_disabled_bg_3.1"
            app:layout_constraintTop_toBottomOf="@+id/recycler_sublist"/>

    </com.dmss.burbankapp.utility.ExpandableLayout>


</androidx.constraintlayout.widget.ConstraintLayout>