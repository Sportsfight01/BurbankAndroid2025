<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f6f6f6"
    tools:context=".ui.designs.MyCollectionFavDesignFragment">

    <RelativeLayout
        android:id="@+id/rl_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/appColor"
        android:paddingLeft="27dp"
        android:paddingTop="23dp"
        android:paddingRight="27dp">

        <ImageView
            android:id="@+id/iv_profile"
            android:layout_width="37dp"
            android:layout_height="37dp"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="16dp"
            android:src="@mipmap/logo_myplace" />

        <LinearLayout
            android:id="@+id/ll_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:textAppearance="@style/FontExtraBold"
                android:lineSpacingExtra="6sp"
                android:text="My"
                android:textColor="@color/black"
                android:textSize="29sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:textAppearance="@style/FontExtraBold"
                android:lineSpacingExtra="6sp"
                android:paddingLeft="6dp"
                android:text="Collection"
                android:textColor="#ffffff"
                android:textSize="29sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_tool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_header"
            android:layout_marginTop="7dp"
            android:letterSpacing="0.02"
            android:lineSpacingExtra="1sp"
            android:text="North | Single | 4+ Beds | $420k - $550k"
            android:textColor="#ffffff"
            android:textSize="12sp" />

        <!--<TextView
            android:id="@+id/tv_tool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ll_header"
            android:layout_marginTop="10dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="70dp"
            android:ellipsize="end"
            android:lineSpacingExtra="1sp"
            android:maxLines="1"
            android:text=". . . .."
            android:textColor="#ffffff"
            android:textSize="16sp" />-->

        <TextView
            android:id="@+id/tv_sort_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_tool"
            android:layout_alignParentLeft="true"
            android:layout_marginTop="19dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/rectangel_line"
            android:lineSpacingExtra="1sp"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:text="SORT / FILTER"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_tool"
            android:layout_marginLeft="20dp"

            android:layout_marginTop="19dp"
            android:layout_marginBottom="30dp"
            android:layout_toRightOf="@+id/tv_sort_filter"
            android:background="@drawable/rectangel_line"
            android:lineSpacingExtra="1sp"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:text="22 DESIGNS"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_favorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_tool"
            android:layout_alignParentRight="true"
            android:layout_marginTop="19dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/rectangel_line"
            android:lineSpacingExtra="1sp"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:text="FAVORITES"
            android:textColor="@color/white"
            android:textSize="12sp" />

    </RelativeLayout>

    <ScrollView
        android:layout_below="@+id/rl_top"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rl_top">

            <include
                android:id="@+id/id_item"
                layout="@layout/list_collection_item" />

            <View
                android:id="@+id/view_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_below="@+id/id_item"
                android:background="@color/appColor" />

            <ImageView
                android:id="@+id/iv_full"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/view_line"
                android:layout_marginTop="30dp"
                android:src="@drawable/house_icon"
                android:visibility="visible" />
        </RelativeLayout>

    </ScrollView>




</RelativeLayout>