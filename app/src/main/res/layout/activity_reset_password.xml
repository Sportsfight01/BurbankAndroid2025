<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_3.1"
    tools:context=".ui.login.ResetPasswordActivity">

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/back_icon_height_width"
        android:layout_height="@dimen/back_icon_height_width"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/_25dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/back_png_grey"
        app:tint="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <LinearLayout
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">

            <ImageView
                android:id="@+id/profile_view"
                android:layout_width="@dimen/login_logo"
                android:layout_height="@dimen/login_logo"
                android:layout_alignParentTop="true"
                android:layout_gravity="center"
                android:layout_marginStart="25dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="25dp"
                android:src="@mipmap/logo_myplace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_23sdp"
                android:gravity="start"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                     android:textAppearance="@style/FontMedium"
                    android:lineSpacingExtra="6sp"
                    android:text="Reset"
                    android:textColor="@color/black_bg_3.1"
                    android:textSize="@dimen/header_size" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                     android:textAppearance="@style/FontMedium"
                    android:lineSpacingExtra="6sp"
                    android:text="Password"
                    android:textColor="@color/grey_text_font_3.1"
                    android:textSize="@dimen/header_size" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5dp"
                android:textAppearance="@style/FontMedium"
                android:text="Reset your Password here"
                android:textColor="@color/black_bg_3.1"
                android:textSize="@dimen/sub_header_size"
                />

            <LinearLayout
                android:id="@+id/ll_social"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/passcode"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/rectangle_grey_line"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="start|center"
                    android:hint="@string/enter_passcode"
                    android:paddingStart="@dimen/_16dp"
                    android:inputType="number"
                    android:paddingEnd="@dimen/_16dp"
                    android:textCursorDrawable="@null"
                    android:textColor="@color/black_bg_3.1"
                    android:textSize="@dimen/text_field_size" />

                <EditText
                    android:id="@+id/enternewpassword"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/rectangle_grey_line"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="start|center"
                    android:hint="@string/enter_new_password"
                    android:paddingStart="16dp"
                    android:textCursorDrawable="@null"
                    android:paddingEnd="@dimen/_16dp"
                    android:textColor="@color/black_bg_3.1"
                    android:textSize="@dimen/text_field_size" />

                <EditText
                    android:id="@+id/enterconfirmpassword"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/rectangle_grey_line"
                     android:textAppearance="@style/FontMedium"
                    android:gravity="start|center"
                    android:hint="@string/confirm_password"
                    android:paddingStart="16dp"
                    android:textCursorDrawable="@null"
                    android:paddingEnd="@dimen/_16dp"
                    android:textColor="@color/black_bg_3.1"
                    android:textSize="@dimen/text_field_size" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_submit"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/_40dp"
                android:background="@drawable/rectangle_orange_bg"
                 android:textAppearance="@style/FontMedium"
                android:gravity="center"
                android:lineSpacingExtra="3sp"
                android:text="Reset"
                android:textColor="@color/white_3.1"
                android:textSize="@dimen/button_text_size" />

            <LinearLayout
                android:id="@+id/ll_forgot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/resendPasscode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textAppearance="@style/FontMedium"
                    android:includeFontPadding="false"
                    android:text="Resend Passcode"
                    android:textColor="@color/grey_text_font_3.1"
                    android:textSize="@dimen/sub_header_size"
                     />


            </LinearLayout>

        </LinearLayout>


    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>