<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/body_bg_3.1">

    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="@dimen/_10dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/back_icon_height_width"
            android:layout_height="@dimen/back_icon_height_width"
            android:layout_alignParentTop="true"
            android:src="@drawable/back_png_grey"
            app:tint="@color/black_bg_3.1" />

        <LinearLayout
            android:id="@+id/ll_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/iv_back"
            android:layout_toEndOf="@+id/iv_back"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center"
                android:layout_marginTop="@dimen/_5dp"
                android:ellipsize="end"
                android:textAppearance="@style/FontMedium"
                android:gravity="center|start"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:layout_marginLeft="5sp"
                android:text="@string/take_a_quick_survey_to_find_your_perfect_design"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="@dimen/sub_header_size"
                android:visibility="gone" />

            <com.dmss.burbankapp.ui.view.CustomRecyclerView
                android:id="@+id/customRecyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_3dp"
                android:visibility="visible" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/ll_designs_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iv_back"
            android:layout_alignStart="@+id/ll_container"
            android:layout_marginTop="@dimen/_15dp"
            android:orientation="horizontal"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ll_container"
                android:layout_marginTop="@dimen/_15dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rectangle_orange_bg"
                android:gravity="start"
                android:textAppearance="@style/FontMedium"
                android:lineSpacingExtra="1sp"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp"
                android:textSize="12sp"
                android:text="RESET"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_total_designs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ll_container"
                android:layout_marginTop="@dimen/_15dp"
                android:layout_marginEnd="10dp"
                android:layout_toRightOf="@+id/tv_reset"
                android:background="@drawable/rectangle_grey"
                android:lineSpacingExtra="1sp"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp"
                android:text="TOTAL DESIGNS"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textAppearance="@style/FontMedium"
                android:textColor="@color/white"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            <include layout="@layout/profile_with_badge"></include>
                </LinearLayout>
            <!-- <TextView
                android:id="@+id/tv_favorites"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_tool"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="10dp"
                android:background="@drawable/rectangle_light_orange"
                android:gravity="end"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:text="@string/myprofile"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:layout_marginTop="@dimen/_7sdp"
                 android:textAppearance="@style/FontRegular"
                android:textColor="@color/white"
               />
            <TextView
                android:id="@+id/profile_notification"
                android:layout_width="@dimen/_18sp"
                android:layout_height="@dimen/_18sp"
                android:layout_below="@+id/rl_tool"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="5dp"
                android:background="@drawable/black_round"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="0"
                android:textSize="@dimen/_7sdp"
                android:textColor="@color/white" />-->

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_how_does_it"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/iv_back"
            android:layout_alignStart="@+id/ll_container"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/rectangel_line"
            android:paddingLeft="10dp"
            android:paddingTop="6dp"
            android:textSize="12sp"
            android:paddingRight="10dp"
            android:paddingBottom="6dp"
            android:text="@string/how_does_it_work"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textAppearance="@style/FontMedium"
            android:visibility="invisible" />


    </RelativeLayout>
<View
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="@color/black"
    android:layout_below="@+id/rl_header"/>

</RelativeLayout>