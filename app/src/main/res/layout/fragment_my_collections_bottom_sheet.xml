<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"

    android:layout_height="match_parent"
    android:background="@drawable/rectanagle_filter"
    tools:context=".ui.designs.MyCollectionsBottomSheetFragment">

    <RelativeLayout
        android:id="@+id/ll_skip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/tv_first"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:letterSpacing="0.02"
            android:lineSpacingExtra="3sp"
            android:text="Price Range"
             android:textAppearance="@style/FontRegular"
            android:textAllCaps="false"
            android:textColor="#231f20"
            android:textSize="19sp"
            android:layout_alignParentStart="true" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:src="@drawable/close_icon" />

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ll_skip">

        <LinearLayout
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:orientation="vertical"
            android:paddingLeft="34dp"
            android:paddingRight="34dp"
            android:paddingBottom="21dp"
            android:visibility="visible">

           <!-- <com.crystal.crystalrangeseekbar.widgets.CrystalRangeSeekbar
                android:id="@+id/seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:bar_color="@color/light_grey_disabled_bg_3.1"
                app:bar_highlight_color="@color/grey_text_font_3.1"
                app:corner_radius="10"
                app:data_type="_integer"
                app:left_thumb_image="@drawable/range_seek"
                app:right_thumb_image="@drawable/range_seek"
                app:max_value="500"
                app:min_value="100"
                />-->

            <TextView
                android:id="@+id/tv_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:gravity="center"
               android:textAppearance="@style/FontLight"
                android:letterSpacing="0.03"
                android:lineSpacingExtra="4sp"
                android:text="$390K to $480K"
                android:textColor="#5c5e5e"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/ll_bar"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:weightSum="7">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center|top"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bar_lines"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="32"
                    android:backgroundTint="#fee2c8"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center|top"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bar_lines"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:backgroundTint="#fee2c8"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="45"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center|top"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#faa658"
                    android:background="@drawable/bar_lines"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="23"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center|top"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:backgroundTint="#f68b1f"
                    android:background="@drawable/bar_lines"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="88"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:backgroundTint="#faa658"
                    android:layout_gravity="center|top"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bar_lines"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="67"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:backgroundTint="#fdc997"
                    android:layout_height="50dp"
                    android:layout_gravity="center|top"
                    android:layout_marginLeft="2dp"
                    android:layout_marginRight="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bar_lines"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="52"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="0dp"
                    android:backgroundTint="#fee2c8"
                    android:layout_height="40dp"
                    android:layout_gravity="center|top"
                    android:layout_marginLeft="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bar_lines"
                    android:gravity="center|top"
                    android:letterSpacing="0.02"
                    android:lineSpacingExtra="3sp"
                    android:paddingTop="10dp"
                    android:text="43"
                    android:textColor="#ffffff"
                    android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/viewLine" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/iv_storeys"
                        android:layout_width="15dp"
                        android:layout_height="13dp"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/storey_grey"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_toRightOf="@+id/iv_storeys"
                        android:letterSpacing="0.01"
                        android:lineSpacingExtra="4sp"
                        android:text="Storeys"
                         android:textAppearance="@style/FontRegular"
                        android:textColor="#5c5e5e"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="24dp"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/rectanngel_box_line"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        android:weightSum="3">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/left_filled_drwable"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="2"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="ALL"
                            android:textSize="10sp" />

                    </LinearLayout>
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/viewLine" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/iv_bedrooms"
                        android:layout_width="15dp"
                        android:layout_height="13dp"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bed_grey"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                         android:textAppearance="@style/FontRegular"
                        android:layout_toRightOf="@+id/iv_bedrooms"
                        android:letterSpacing="0.01"
                        android:lineSpacingExtra="4sp"
                        android:text="Bedrooms"
                        android:textColor="#5c5e5e"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="130dp"
                        android:layout_height="24dp"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/rectanngel_box_line"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        android:weightSum="4">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/box_grey"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/box_grey"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="5+"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/right_filled_drwable"
                            android:gravity="center"
                            android:text="ALL"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                    </LinearLayout>
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/viewLine" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/iv_car_spaces"
                        android:layout_width="15dp"
                        android:layout_height="13dp"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/car_grey"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_toRightOf="@+id/iv_car_spaces"
                        android:letterSpacing="0.01"
                        android:lineSpacingExtra="4sp"
                        android:text="Car Spaces"
                         android:textAppearance="@style/FontRegular"
                        android:textColor="#5c5e5e"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="24dp"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/rectanngel_box_line"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        android:weightSum="3">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/box_grey"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/center_filled_drawable"
                            android:gravity="center"
                            android:text="5+"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="ALL"
                            android:textColor="@color/box_grey"
                            android:textSize="10sp" />

                    </LinearLayout>
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/viewLine" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/iv_bathrooms"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentLeft="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bath_grey"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:layout_toRightOf="@+id/iv_bathrooms"
                        android:letterSpacing="0.01"
                        android:lineSpacingExtra="4sp"
                        android:text="Bathrooms"
                        android:textColor="#5c5e5e"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="24dp"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/rectanngel_box_line"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        android:weightSum="3">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/box_grey"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="5+"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:background="@drawable/right_filled_drwable"
                            android:gravity="center"
                            android:text="ALL"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                    </LinearLayout>
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/viewLine" />

                <RelativeLayout
                    android:id="@+id/rl_sort_by"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:letterSpacing="0.03"
                        android:lineSpacingExtra="4sp"
                        android:text="Sort by"
                         android:textAppearance="@style/FontRegular"
                        android:textColor="#5c5e5e"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toLeftOf="@+id/iv_drop_down"
                        android:letterSpacing="0.03"
                        android:lineSpacingExtra="4sp"
                        android:text="Price (Low - High)"
                        android:textColor="#5c5e5e"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/iv_drop_down"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:layout_marginLeft="14dp"
                        android:padding="5dp"
                        android:src="@drawable/drop_down" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="21dp"
                    android:background="@drawable/rectangel_skip"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_search" />
                </LinearLayout>


            </LinearLayout>
        </LinearLayout>

    </ScrollView>

</RelativeLayout>