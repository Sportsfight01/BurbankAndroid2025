<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_3.1"
    android:paddingBottom="@dimen/_55dp"
    tools:context=".ui.loginhome.LoginHomeActivity">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:paddingTop="@dimen/_30dp"
        android:paddingBottom="@dimen/_30dp"
        app:layout_constraintTop_toTopOf="parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_22dp"
        android:paddingEnd="@dimen/_22dp"
      >

        <ImageView
            android:id="@+id/back_image"
            android:layout_width="@dimen/back_icon_height_width"
            android:layout_height="@dimen/back_icon_height_width"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="center"
            android:src="@drawable/back_arrow"
            app:tint="@color/black_bg_3.1" />

        <ImageView
            android:layout_marginTop="@dimen/_3dp"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_gravity="left"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/back_image"
            android:layout_marginStart="@dimen/_10dp"
            android:src="@drawable/burbank_header_logo" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_profile_pic"
            android:layout_width="@dimen/profile_pic"
            android:layout_height="@dimen/profile_pic"
            android:layout_alignParentEnd="true"
            android:layout_alignParentRight="true"
            android:visibility="gone"
            android:layout_marginRight="25dp"
            android:src="@mipmap/logo_myplace" />
    </RelativeLayout>
        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:lineSpacingExtra="6sp"
                    android:text="Sign"
                    android:textAppearance="@style/FontMedium"
                    android:textColor="@color/black_bg_3.1"
                    android:textSize="@dimen/header_size" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/FontMedium"
                    android:lineSpacingExtra="6sp"
                    android:text="In"
                    android:textColor="@color/grey_text_font_3.1"
                    android:textSize="@dimen/header_size" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5dp"
                android:text="@string/choose_your_method_of_sign_in"
                android:textColor="@color/black_bg_3.1"
                android:textSize="@dimen/sub_header_size"
                android:textAppearance="@style/FontMedium"
                />

            <LinearLayout
                android:id="@+id/ll_social"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/fl_google"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/rectangel_shape">

                    <com.google.android.gms.common.SignInButton
                        android:id="@+id/sign_in_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />


                    <LinearLayout
                        android:id="@+id/ll_google"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/rectangle_grey_line"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp">

                        <ImageView
                            android:id="@+id/iv_google"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/google" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="16dp"
                            android:gravity="center"
                            android:text="Sign in with Google"
                            android:textAppearance="@style/FontMedium"
                            android:textColor="@color/grey_text_font_3.1"
                            android:textSize="@dimen/text_field_size" />
                    </LinearLayout>

                </FrameLayout>


                <FrameLayout
                    android:id="@+id/fl_facebook"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:visibility="gone"
                    android:layout_marginTop="10dp">

                    <com.facebook.login.widget.LoginButton
                        android:id="@+id/login_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center" />

                    <LinearLayout
                        android:id="@+id/ll_facebook"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/rectangel_blue"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp">


                        <ImageView
                            android:id="@+id/iv_facebook"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/facebook" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:layout_marginStart="16dp"
                            android:layout_marginLeft="16dp"
                            android:gravity="center"
                            android:lineSpacingExtra="2sp"
                            android:text="Sign in with Facebook"
                             android:textAppearance="@style/FontMedium"
                            android:textColor="@color/white_3.1"
                            android:textSize="@dimen/text_field_size" />
                    </LinearLayout>
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/fl_email"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp">
                <LinearLayout
                    android:id="@+id/ll_continue_email"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/email_border_bg"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp">

                    <ImageView
                        android:id="@+id/iv_email"
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/email"
                        android:tint="@color/white_3.1" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_marginLeft="16dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2sp"
                        android:text="Sign in with Email"
                        android:textAppearance="@style/FontMedium"
                        android:textColor="@color/white_3.1"
                        android:textSize="@dimen/text_field_size" />
                </LinearLayout>
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_skip"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/rectangle_orange_bg"
            android:textAppearance="@style/FontMedium"
            android:gravity="center"
            android:lineSpacingExtra="3sp"
            android:text="Skip"
            android:textColor="@color/white_3.1"
            android:textSize="@dimen/button_text_size" />

        <ProgressBar
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>