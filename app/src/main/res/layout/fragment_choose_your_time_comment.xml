    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white_3.1"
        android:paddingStart="20dp"
        android:paddingTop="2dp"
        android:paddingEnd="2dp"
        android:layout_alignParentTop="true"
        android:paddingBottom="@dimen/_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="@dimen/back_icon_height_width"
            android:layout_height="@dimen/back_icon_height_width"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/back_png_grey"
            />


        <LinearLayout
            android:id="@+id/ll_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/iv_back"
            android:orientation="horizontal"
            android:layout_centerVertical="true"
            android:padding="@dimen/_10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/FontRegular"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0sp"
                android:text="Enquire"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="@dimen/header_size" />

            <TextView
                android:id="@+id/tv_header_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/FontMedium"
                android:lineSpacingExtra="0sp"
                android:paddingStart="0dp"
                android:text="@string/now"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="@dimen/header_size" />

        </LinearLayout>
        <ImageView
            android:id="@+id/iv_profile"
            android:layout_width="@dimen/profile_pic"
            android:layout_height="@dimen/profile_pic"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:src="@mipmap/logo_myplace"
            app:civ_border_width="0dp" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/ll_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_header"
        android:background="@color/enabled_orange_bg_3.1"
        android:gravity="start"
        android:visibility="gone"
        android:orientation="vertical"
        android:paddingStart="@dimen/_20dp"
        android:paddingEnd="@dimen/_10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_gravity="start"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_10dp"
            android:textAppearance="@style/FontMedium"
            android:gravity="start"
            android:textSize="@dimen/default_text_size"
            android:text="Botanical estate"
            android:textAllCaps="true"
            android:textColor="@color/white_3.1" />

        <TextView
            android:id="@+id/tv_ondisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_header"
            android:layout_alignParentStart="true"
            android:layout_gravity="start"
            android:layout_marginBottom="@dimen/_10dp"
            android:layout_toStartOf="@+id/ll_end"
            android:textAppearance="@style/FontMedium"
            android:maxLines="2"
            android:textSize="@dimen/default_text_size"
            android:text="Poppy Street, Mickleham Poppy Street Mickleham Poppy Street "
            android:textAllCaps="false"
            android:textColor="@color/white_3.1" />


        <LinearLayout
            android:id="@+id/ll_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_gravity="end"
            android:gravity="center"
            android:paddingStart="@dimen/_10dp"
            android:paddingTop="@dimen/_8dp"
            android:paddingBottom="@dimen/_8dp">

            <TextView
                android:id="@+id/tv_street_suburb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginEnd="@dimen/_5dp"
                android:textAppearance="@style/FontMedium"
                android:gravity="end"
                android:textSize="@dimen/default_text_size"
                android:text="Poppy Street,\nMickleham"
                android:textAllCaps="false"
                android:textColor="@color/grey_text_font_3.1" />

        </LinearLayout>
    </RelativeLayout>
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ll_container"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:layout_below="@+id/ll_container">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/_16dp"
            android:paddingStart="@dimen/_30dp"
            android:paddingEnd="@dimen/_30dp">

            <TextView
                android:id="@+id/tv_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/_5dp"
                android:textAppearance="@style/FontMedium"
                android:text="Tuesday,March 3"
                android:textAllCaps="false"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="@dimen/_16sp"
                />

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_day"
                android:layout_marginStart="@dimen/_5dp"
                android:textAppearance="@style/FontMedium"
                android:text="Morning"
                android:textAllCaps="true"
                android:textColor="@color/orange_bg_3.1"
                android:textSize="@dimen/_14sp"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_time"
                android:layout_marginTop="@dimen/_10dp">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/_10dp"
                    android:paddingEnd="@dimen/_10dp"
                    app:layout_constraintGuide_percent="0.5" />

                <EditText
                    android:id="@+id/firstName"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40dp"
                    android:layout_marginEnd="@dimen/_10dp"
                    android:background="@drawable/rectangel_shape"
                    android:hint="First Name"
                    android:inputType="text"
                    android:textCursorDrawable="@null"
                    android:textColor="@color/black_bg_3.1"
                    android:lines="1"
                    android:textAppearance="@style/FontMedium"
                    android:paddingStart="@dimen/_10dp"
                    android:paddingEnd="@dimen/_5dp"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/lastName"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40dp"
                    android:layout_marginStart="@dimen/_10dp"
                    android:textColor="@color/black_bg_3.1"
                    android:background="@drawable/rectangel_shape"
                    android:hint="Last Name"
                    android:inputType="text"
                    android:textCursorDrawable="@null"
                    android:paddingStart="@dimen/_10dp"
                    android:paddingEnd="@dimen/_5dp"
                    android:textAppearance="@style/FontMedium"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guideline"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/phone"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40dp"
                    android:layout_marginTop="@dimen/_10dp"
                    android:layout_marginEnd="@dimen/_10dp"
                    android:background="@drawable/rectangel_shape"
                    android:digits="0123456789"
                    android:hint="Phone"
                    android:inputType="phone"
                    android:lines="1"
                    android:textAppearance="@style/FontMedium"
                    android:maxLength="14"
                    android:textCursorDrawable="@null"
                    android:textColor="@color/black_bg_3.1"
                    android:paddingStart="@dimen/_10dp"
                    android:paddingEnd="@dimen/_5dp"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@+id/guideline"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/firstName" />

                <EditText
                    android:id="@+id/email"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40dp"
                    android:layout_marginStart="@dimen/_10dp"
                    android:layout_marginTop="@dimen/_10dp"
                    android:background="@drawable/rectangel_shape"
                    android:hint="Email"
                    android:inputType="textEmailAddress"
                    android:paddingStart="@dimen/_10dp"
                    android:textCursorDrawable="@null"
                    android:paddingEnd="@dimen/_5dp"
                    android:textSize="14sp"
                    android:textAppearance="@style/FontMedium"
                    android:textColor="@color/black_bg_3.1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guideline"
                    app:layout_constraintTop_toBottomOf="@+id/lastName" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <Spinner
                android:id="@+id/localPlaceSpinner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40dp"
                android:layout_below="@+id/cl_container"
                android:layout_marginTop="10dp"
                android:background="@drawable/rectangel_shape" />

            <EditText
                android:id="@+id/et_comment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/localPlaceSpinner"
                android:layout_marginTop="@dimen/_10dp"
                android:background="@drawable/rectangel_shape"
                android:gravity="start|top"
                android:textCursorDrawable="@null"
                android:hint="Comments"
                android:lines="5"
                android:textAppearance="@style/FontMedium"
                android:textSize="14sp"
                android:textColor="@color/black_bg_3.1"
                android:padding="@dimen/_16dp" />

            <Button
                android:id="@+id/btnEnq"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_below="@+id/consentCheckLL"
                android:layout_marginTop="10dp"
                android:background="@drawable/rectangel_skip"
                android:textAppearance="@style/FontMedium"
                android:gravity="center"
                android:text="Request Appointment"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/consentCheckLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/et_comment"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_check"
                    android:layout_width="21dp"
                    android:layout_height="31dp"
                    android:src="@drawable/uncheck_checkbox" />

                <TextView
                    android:id="@+id/tv_privacy"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/FontMedium"
                    android:gravity="start"
                    android:paddingStart="@dimen/_10dp"
                    android:justificationMode="inter_word"
                    android:paddingEnd="@dimen/_10dp"
                    android:text="I accept Burbank's privacy policy and wish to receive Burbank's latest news and offers on my email."
                    android:textColor="@color/grey_text_font_3.1"
                    android:textSize="@dimen/_14sp" />
            </LinearLayout>

        </RelativeLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>