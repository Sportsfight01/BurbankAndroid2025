<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"

    >

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <RelativeLayout
        android:id="@+id/rl_first"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:id="@+id/rl_place"
            android:layout_width="@dimen/_80dp"
            android:layout_height="@dimen/_60dp">

            <ImageView
                android:id="@+id/iv_place"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:background="@drawable/rectangle_test" />

            <ProgressBar
                android:id="@+id/place_progress"
                android:layout_width="@dimen/_30dp"
                android:layout_height="@dimen/_30dp"
                android:layout_centerInParent="true" />
        </RelativeLayout>


        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_70dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_centerHorizontal="true"
            android:layout_toEndOf="@+id/rl_place"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/previous"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:src="@drawable/ic_arrow_back"
                android:layout_centerVertical="true"
                android:visibility="gone"
                android:layout_alignParentLeft="true"
                android:layout_marginEnd="@dimen/_5dp"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toRightOf="@+id/previous"
                android:layout_centerVertical="true">
                <TextView
                    android:id="@+id/tv_place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                     android:textAppearance="@style/FontMedium"
                    android:textColor="@color/grey_text_font_3.1"
                    android:textSize="16sp"
                    android:maxLines="3"
                    tools:text="CarterCartersaassassaaaaaassa 234" />

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                     android:textAppearance="@style/FontMedium"
                    android:text="$234,500"
                    android:visibility="visible"
                    android:textColor="@color/orange_bg_3.1"
                    android:textSize="14sp"
                    />
            </LinearLayout>


        </RelativeLayout>


    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rl_second"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="@dimen/_10dp"
        android:gravity="end"
        android:layout_toEndOf="@+id/rl_first"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:id="@+id/rl_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/_1dp"

            android:gravity="center">

            <ImageView
                android:id="@+id/iv_bedrooms"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/third_eminities" />

            <TextView
                android:id="@+id/tv_bed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_bedrooms"
                android:layout_alignStart="@id/iv_bedrooms"
                android:layout_alignEnd="@id/iv_bedrooms"
                 android:textAppearance="@style/FontMedium"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="12sp" />


            <ImageView
                android:id="@+id/iv_bathrooms"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="10dp"
                android:layout_marginLeft="3dp"
                android:layout_marginEnd="5dp"
                android:layout_marginRight="3dp"
                android:layout_toEndOf="@+id/iv_bedrooms"
                android:layout_toRightOf="@+id/iv_bedrooms"
                android:src="@drawable/bath_eminities" />

            <TextView
                android:id="@+id/tv_bath"
                android:layout_width="12dp"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_bedrooms"
                android:layout_alignStart="@id/iv_bathrooms"
                android:layout_alignEnd="@id/iv_bathrooms"
                android:layout_marginStart="4dp"
                 android:textAppearance="@style/FontMedium"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="12sp" />

            <View
                android:id="@+id/ba_line_bath"
                android:layout_width="@dimen/_1dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:background="@color/light_grey_disabled_bg_3.1"
                android:layout_marginStart="@dimen/_5dp"
                android:layout_marginEnd="@dimen/_5dp"
                android:layout_toRightOf="@+id/iv_bedrooms" />


            <ImageView
                android:id="@+id/iv_car"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="5dp"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:layout_toEndOf="@+id/iv_bathrooms"
                android:src="@drawable/car_eminities" />

            <TextView
                android:id="@+id/tvcar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/iv_bedrooms"
                android:layout_alignStart="@id/iv_car"
                android:layout_alignEnd="@id/iv_car"
                 android:textAppearance="@style/FontMedium"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="12sp" />

            <View
                android:id="@+id/bar_line_tvcar"
                android:layout_width="@dimen/_1dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:background="@color/light_grey_disabled_bg_3.1"
                android:layout_marginRight="5dp"
                android:layout_toLeftOf="@+id/tvcar" />

        </RelativeLayout>


        <LinearLayout
            android:id="@+id/ll_circle"
            android:layout_width="@dimen/_50dp"
            android:layout_height="@dimen/_50dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_5dp"
                android:layout_marginEnd="@dimen/_5dp"
            android:layout_toEndOf="@+id/rl_container"
            android:background="@drawable/circle_line"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/lot"
                android:textAppearance="@style/FontMedium"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="7sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="WIDTH"
                android:textAppearance="@style/FontMedium"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="7sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_8dp"
                android:layout_gravity="center"
                android:tint="@color/orange_bg_3.1"
                android:src="@drawable/icon_lot" />

            <TextView
                android:id="@+id/tv_width"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14m"
                android:textAppearance="@style/FontMedium"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="10sp" />


        </LinearLayout>

        <ImageView
            android:id="@+id/iv_like"
            android:layout_width="@dimen/_24dp"
            android:layout_height="@dimen/_24dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:src="@drawable/heart_bottom_svg"
            android:visibility="visible" />
        <ImageView
            android:id="@+id/next"
            android:layout_width="@dimen/_10sdp"
            android:layout_height="@dimen/_10sdp"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone"
            android:layout_toRightOf="@+id/iv_like"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_5dp"
            android:rotation="180"
            />

    </RelativeLayout>



</androidx.constraintlayout.widget.ConstraintLayout>