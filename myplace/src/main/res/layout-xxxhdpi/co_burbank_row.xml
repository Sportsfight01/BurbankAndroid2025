<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:background="@drawable/rectangel_white_button"
    android:orientation="vertical">
    <LinearLayout
        android:padding="10dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <ImageView
android:layout_gravity="center_vertical"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/co_burbank"  />
    <LinearLayout
        android:paddingLeft="5dp"
        android:orientation="vertical"
        android:layout_width="200dp"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/userName"
            android:textColor="@color/black"
            android:text="Mr.Alfred"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/details"
            android:textSize="12dp"
            android:text="alfred@gmail.com"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>
        <RelativeLayout

            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_alignParentRight="true"
                android:layout_width="wrap_content"
                android:layout_height="50dp">
                <Button
                    android:visibility="gone"
                    android:id="@+id/accept"
                    android:textAllCaps="false"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/orange_btn_fullcolor"
                    android:textSize="10dp"
                    android:text="Primary"

                    android:textColor="@color/white"
                    android:layout_marginRight="10dp"
                    android:layout_width="70dp"
                    android:layout_height="35dp"
                    android:padding="5dp"
                    android:layout_centerVertical="true"
                    android:layout_toLeftOf="@+id/accept"
                    android:layout_toStartOf="@+id/accept"
                    />
                <Button
                    android:visibility="visible"
android:textSize="10dp"
                    android:textAllCaps="false"
                    android:layout_centerVertical="true"
                    android:background="@drawable/grey_btn_fullcolor"
                    android:text="Accept"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="35dp"
                    android:padding="5dp"
                    android:id="@+id/primary"
                    android:layout_alignParentRight="true"
                    />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
    <View
        android:background="@color/white"


        android:layout_width="match_parent"
        android:layout_height="3dp"/>
</LinearLayout>
