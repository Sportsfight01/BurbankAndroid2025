<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
   >

    <!-- TODO: Update blank fragment layout -->
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_12ssp"
        android:layout_margin="@dimen/_19sdp"
        android:id="@+id/issue_name"
        android:textSize="@dimen/_14ssp"
        android:text="MINOR DEFECTS"
        android:textColor="@color/orange_bg_3.1"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints,RtlSymmetry" />
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/issue_description"
        android:text="Your minor defects list is due on or before Monday 5th February 2022"
        android:textSize="@dimen/_12ssp"
        android:layout_marginLeft="@dimen/_19sdp"
        app:layout_constraintTop_toBottomOf="@+id/issue_name"
        android:layout_marginTop="@dimen/_5dp"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_155sdp"
        android:id="@+id/ll_video_bg"
        android:layout_marginLeft="@dimen/_9sdp"
        android:layout_marginRight="@dimen/_9sdp"
        android:layout_marginBottom="@dimen/_5dp"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintTop_toBottomOf="@+id/issue_description"
        android:background="@drawable/grey_top_rounded_corners"
        android:orientation="horizontal" />
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/rr_item_layout"
    app:layout_constraintTop_toBottomOf="@+id/ll_video_bg"
    android:layout_margin="@dimen/_19sdp">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        android:id="@+id/report_icon"

        android:src="@drawable/reportcircle"
        app:layout_constraintStart_toStartOf="parent" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_15ssp"
            android:layout_toRightOf="@+id/report_icon"
            android:orientation="vertical">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/report_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="YOU HAVE 0 ISSUES LOGGED"
        android:textSize="@dimen/_12ssp"
       android:textAppearance="@style/FontBold"

         />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/report_title_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add you issues below. Remember to have allissues completed before submitting"
        android:textSize="@dimen/_12ssp"
        android:layout_marginTop="@dimen/_5dp"
        android:textAppearance="@style/FontRegular"
        />

        </LinearLayout>

</RelativeLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Please submit your issues before Monday, 5th February, 2022"
        android:textSize="@dimen/_12ssp"
        android:layout_marginLeft="@dimen/_9sdp"
        android:layout_marginRight="@dimen/_9sdp"
        android:textColor="@color/orange_bg_3.1"
        android:textAppearance="@style/FontRegular"
        android:layout_marginBottom="@dimen/_5dp"
        android:layout_marginTop="@dimen/_5sdp"
        app:layout_constraintTop_toBottomOf="@+id/rr_item_layout"/>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp"
        android:background="@drawable/orange_btn_fullcolor"
        android:id="@+id/REPORT_MINOR_DEFECTS"
        android:layout_marginLeft="@dimen/_30dp"
        android:layout_marginRight="@dimen/_30dp"
        app:layout_constraintTop_toBottomOf="@+id/note"
        android:textColor="@color/white_3.1"
        android:layout_marginTop="@dimen/_15dp"
        android:textSize="@dimen/_12ssp"
        android:textAppearance="@style/FontMedium"
        android:text="@string/REPORT_MINOR_DEFECTS" />
    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="@dimen/_30sdp"
        android:background="@drawable/orange_btn_fullcolor"
        android:id="@+id/REPORT_OTHER_ISSUES"
        android:layout_marginLeft="@dimen/_30dp"
        android:layout_marginRight="@dimen/_30dp"
        app:layout_constraintTop_toBottomOf="@+id/REPORT_MINOR_DEFECTS"
        android:textColor="@color/white_3.1"
        android:layout_marginTop="@dimen/_10dp"
        android:textSize="@dimen/_12ssp"
        android:textAppearance="@style/FontMedium"
        android:text="@string/REPORT_OTHER_ISSUES" />
</androidx.constraintlayout.widget.ConstraintLayout>
