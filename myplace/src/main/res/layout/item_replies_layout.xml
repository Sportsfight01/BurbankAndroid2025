<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/rounder_corners_white"
    android:paddingLeft="@dimen/_14sdp"
    android:paddingRight="@dimen/_14sdp"

    android:paddingBottom="@dimen/_10dp"
    android:paddingTop="@dimen/_10dp"
    android:layout_marginTop="@dimen/_5sdp">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:fontFamily="@font/montserrat_medium"
        android:textColor="@color/black_bg_3.1"
        android:textSize="14sp"
        tools:text="Ben Johnston" />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="reply message"
        android:textAppearance="@style/FontMedium"
        android:textSize="@dimen/_14sp"
        android:textColor="@color/black_bg_3.1"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvReplyDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        tools:text="28/09/2022 10:58 PM"
        android:textColor="@color/disabled_footer_icon_grey_3.1"
        app:fontFamily="@font/montserrat_medium"
        android:textSize="@dimen/_9ssp" />
</androidx.appcompat.widget.LinearLayoutCompat>