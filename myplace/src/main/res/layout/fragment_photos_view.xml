<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".dashboard.ui.photos.PhotosViewFragment">
    <ImageView
        android:id="@+id/sliderView"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/date"
            android:layout_centerInParent="true"
            android:layout_marginTop="@dimen/_20dp"
            android:text="@string/my_details"
            android:textColor="@color/grey_text_font_3.1"
            android:textSize="18sp"
            android:textAppearance="@style/FontMedium"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/date"
            android:textSize="16sp"
            android:layout_marginBottom="@dimen/_20dp"
            android:layout_above="@+id/image_content"
            android:textColor="@color/grey_text_font_3.1"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/_5dp"
            android:text="12-4-2023"/>

        <RelativeLayout
            android:id="@+id/image_content"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/_5dp"
            android:layout_marginTop="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_5dp"
            android:layout_marginBottom="@dimen/_10dp"
            android:visibility="visible">


            <com.dmss.burbankappold.dashboard.ui.photos.ImageZoom
                android:id="@+id/iv_photos"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:src="@drawable/home_img_fixing_stage" />
            <ImageView
                android:id="@+id/left_arrow"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:padding="@dimen/_5sdp"
                android:background="@drawable/circle_shape_bg_white"
                android:layout_marginLeft="@dimen/_5dp"
                android:src="@drawable/back_arrow"
                app:tint="@color/black_bg_3.1" />
            <ImageView
                android:id="@+id/right_arrow"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:rotation="180"
                android:layout_marginRight="@dimen/_5dp"
                android:padding="@dimen/_5sdp"
                android:background="@drawable/circle_shape_bg_white"
                app:tint="@color/black_bg_3.1"
                android:src="@drawable/back_arrow" />
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/progressbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:layout_centerInParent="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>