<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/appColor"
    android:paddingLeft="@dimen/_16dp"
    android:paddingTop="@dimen/_8dp"
    android:paddingBottom="@dimen/_8dp"
    android:paddingRight="@dimen/_16dp"
    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rectangel_white_button"
        android:padding="@dimen/_16dp">


        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/support_profile" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:layout_toStartOf="@+id/ll_status"
            android:layout_marginEnd="@dimen/_10dp"
            android:layout_toEndOf="@+id/thumbnail"
            android:id="@+id/ll_container"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_height="wrap_content">


            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="@dimen/_16sp" />

            <TextView
                android:id="@+id/userEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="@dimen/_14sp" />

            <TextView
                android:id="@+id/userdesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5dp"
                android:text="@string/app_name"
                android:textSize="@dimen/_14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/circuler_drawable_partner"
                android:paddingStart="@dimen/_5dp"
                android:paddingTop="@dimen/_5dp"
                android:gravity="center"
                android:paddingEnd="@dimen/_5dp"
                android:paddingBottom="@dimen/_5dp"
                android:text="@string/partner"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tv_accept"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_5dp"
                android:background="@drawable/circuler_delete_drawable"
                android:paddingStart="@dimen/_10dp"
                android:paddingTop="@dimen/_5dp"
                android:paddingEnd="@dimen/_10dp"
                android:gravity="center"
                android:paddingBottom="@dimen/_5dp"
                android:text="@string/delete"
                android:textColor="@color/white" />

        </LinearLayout>
    </RelativeLayout>


</RelativeLayout>