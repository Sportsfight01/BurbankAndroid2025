<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white_3.1"
    android:padding="@dimen/_20dp">
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_alignParentEnd="true"
        android:src="@drawable/close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/select_job_number"
        android:textColor="@color/black_bg_3.1"
        android:textSize="@dimen/_18sp"
        android:textAppearance="@style/FontMedium"
        app:layout_constraintTop_toBottomOf="@+id/iv_close"
        />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvjobnubers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title"
        android:layout_marginTop="@dimen/_10sdp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="horizontal"
        tools:listitem="@layout/jobnmbers_item"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/select_job_number_helptext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/select_job_number_helptext"
        android:textColor="@color/grey_text_font_3.1"
        android:layout_marginTop="@dimen/_20dp"
        android:textSize="@dimen/default_text_size"
        app:fontFamily="@font/montserrat_medium"
        app:layout_constraintTop_toBottomOf="@+id/rvjobnubers"
        />
</androidx.constraintlayout.widget.ConstraintLayout>