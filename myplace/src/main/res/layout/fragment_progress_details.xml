<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".dashboard.ui.home.ProgressDetailsFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="@dimen/_20sdp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_logo"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:src="@drawable/ic_home_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_tasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="%s of %s Tasks Complete"
            app:layout_constraintStart_toEndOf="@+id/img_logo"
            android:layout_marginStart="@dimen/_20dp"
            android:textColor="@color/new_gray_color"

            android:layout_marginTop="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="@+id/img_logo"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_stage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/tv_tasks"
            app:layout_constraintStart_toStartOf="@+id/tv_tasks"
            tools:text="Frame Stage"
             android:textAppearance="@style/FontMedium"
            android:textColor="@color/dark_grey"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/_5sdp"
            android:textSize="@dimen/_18ssp"/>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:indicatorColor="@color/color_frame_stage"
            app:trackColor="@color/gray_color"
            app:trackCornerRadius="@dimen/_10sdp"
            app:trackThickness="@dimen/_5sdp"
            app:layout_constraintTop_toBottomOf="@+id/tv_stage"
            app:layout_constraintEnd_toStartOf="@+id/tv_progress"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/_20dp"
            android:layout_marginEnd="@dimen/_5sdp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="20%"
            android:textColor="@color/new_gray_color"
            app:layout_constraintTop_toTopOf="@+id/progress"
            app:layout_constraintBottom_toBottomOf="@+id/progress"
            app:layout_constraintEnd_toEndOf="parent" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_stage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_160sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_logo"
            android:layout_marginTop="@dimen/_30sdp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/new_gray_color"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:justificationMode="inter_word"
            app:layout_constraintTop_toBottomOf="@+id/img_stage"
            android:text="@string/lorem_ipsum_text"
            android:layout_marginTop="@dimen/_20sdp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_completion_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/tv_desc"
            app:layout_constraintEnd_toEndOf="parent"
            android:textColor="@color/new_gray_color"
            android:layout_marginTop="@dimen/_30sdp"
            android:text="@string/completion_date"/>
        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_completion_date"
            android:background="@color/lightGrey"
            android:layout_marginTop="@dimen/_2sdp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_tasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/_70sdp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_progress_details_task"
            app:layout_constraintTop_toBottomOf="@+id/view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>