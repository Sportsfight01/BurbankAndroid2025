<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appColor"
    android:orientation="vertical"
    tools:context="com.dmss.burbankappold.ContactsActivity">

    <include layout="@layout/toolbar_detail_screen"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="top"
                android:layout_marginTop="5dp"
                android:src="@drawable/profile_new" />

            <LinearLayout
                android:layout_width="0dp"
                android:paddingEnd="@dimen/_10dp"
                android:paddingStart="@dimen/_30dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Site Supervisor"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textAppearance="@style/FontBold"/>

                <TextView
                    android:id="@+id/supervisorNameTextVew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/supervisorEmailTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/supervisorMobileTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="40dp"
                android:orientation="vertical"
                android:layout_height="80dp">
                <ImageView
                    android:id="@+id/supervisorCallImageView"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/mobile_new"
                    android:visibility="visible" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="5dp" />

                <ImageView
                    android:id="@+id/supervisorMailImageView"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/email_new"
                    android:visibility="visible" />
            </LinearLayout>



        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.4"
            android:background="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="top"
                android:layout_marginTop="5dp"
                android:src="@drawable/profile_new" />

            <LinearLayout
                android:layout_width="0dp"
                android:paddingEnd="@dimen/_10dp"
                android:paddingStart="@dimen/_30dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="New Home Coordinator"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textAppearance="@style/FontBold" />

                <TextView
                    android:id="@+id/croNameTextVew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/croEmailTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/croMobileTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="13sp" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="40dp"
                android:orientation="vertical"
                android:layout_height="80dp">
                <ImageView
                    android:id="@+id/croCallIcon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/mobile_new"
                    android:visibility="visible" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="5dp" />

                <ImageView
                    android:id="@+id/croMailIcon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/email_new"
                    android:visibility="visible" />
            </LinearLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.4"
            android:background="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="top"
                android:layout_marginTop="5dp"
                android:src="@drawable/profile_new" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:paddingEnd="@dimen/_10dp"
                android:paddingStart="@dimen/_30dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Interior Designer"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textAppearance="@style/FontBold"/>

                <TextView
                    android:id="@+id/colorNameTextVew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/colorEmailTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/colorMobileTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="40dp"
                android:orientation="vertical"
                android:layout_height="80dp">
                <ImageView
                    android:id="@+id/colorCallIcon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/mobile_new"
                    android:visibility="visible" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="5dp" />

                <ImageView
                    android:id="@+id/colorMailIcon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/email_new"
                    android:visibility="visible" />
            </LinearLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.4"
            android:background="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="top"
                android:layout_marginTop="5dp"
                android:src="@drawable/profile_new" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_weight="1"
                android:paddingEnd="@dimen/_10dp"
                android:paddingStart="@dimen/_30dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Electrical Designer"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textAppearance="@style/FontBold" />

                <TextView
                    android:id="@+id/electricalNameTextVew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/electricalEmailTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/electricalMobileTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="40dp"
                android:orientation="vertical"
                android:layout_height="80dp">
                <ImageView
                    android:id="@+id/electricalCallIcon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/mobile_new"
                    android:visibility="visible" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="5dp" />

                <ImageView
                    android:id="@+id/electricalMailIcon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@drawable/email_new"
                    android:visibility="visible" />
            </LinearLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.4"
            android:background="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="top"
                android:layout_marginTop="5dp"
                android:src="@drawable/profile_new" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:paddingEnd="@dimen/_10dp"
                android:paddingStart="@dimen/_30dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="New Home Consultant"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textAppearance="@style/FontBold" />

                <TextView
                    android:id="@+id/salesNameTextVew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/salesEmailTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/salesMobileTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/headerTextColor"
                    android:textSize="13sp" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="40dp"
                android:orientation="vertical"
                android:layout_height="80dp">
                <ImageView
                    android:id="@+id/salesCallIcon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="top"
                    android:src="@drawable/mobile_new"
                    android:visibility="visible" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="5dp" />

                <ImageView
                    android:id="@+id/salesMailIcon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_gravity="bottom"
                    android:src="@drawable/email_new"
                    android:visibility="visible" />
            </LinearLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:alpha="0.4"
            android:background="@color/black"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Staff Manager"
                    android:textColor="@color/headerTextColor"
                    android:textSize="15sp"
                    android:textAppearance="@style/FontBold" />

                <TextView
                    android:id="@+id/staffNameTextVew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Name"
                    android:textColor="@color/headerTextColor"
                    android:textSize="14sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/staffCallIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/circle"
                android:padding="8dp"
                android:src="@drawable/mobile_new"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/staffMailIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginLeft="10dp"
                android:background="@drawable/circle"
                android:padding="8dp"
                android:src="@drawable/email_new"
                android:visibility="gone" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="10dp"
            android:alpha="0.4"
            android:background="@color/black" />
    </LinearLayout>

</LinearLayout>
