<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_set_password"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_3.1"
    android:orientation="vertical"
    tools:context="com.dmss.burbankappold.SetPassword">

    <include android:id="@+id/toolbar"
        layout="@layout/custom_dashboard_toolbar"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="39dp"
        android:paddingTop="@dimen/_70sdp"
        android:paddingEnd="39dp">
        <LinearLayout
            android:id="@+id/ll_sign1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Change"
                 android:textAppearance="@style/FontRegular"
                android:lineSpacingExtra="6sp"
                android:textColor="@color/black_bg_3.1"
                android:textSize="@dimen/header_size"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:textAppearance="@style/FontRegular"
                android:lineSpacingExtra="6sp"
                android:text="Password"
                android:textColor="@color/grey_text_font_3.1"
                android:textSize="@dimen/header_size" />

        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5dp"
            android:layout_marginBottom="21dp"
            android:gravity="center|start"
            android:paddingStart="@dimen/_22dp"
            android:text="Change your password here"
            android:textColor="@color/black_bg_3.1"
            android:textSize="@dimen/sub_header_size"
            android:textAppearance="@style/FontBold"

            />
        <LinearLayout
            android:id="@+id/ll_sign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:paddingStart="@dimen/_22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:textAppearance="@style/FontExtraBold"
                android:text="Reset"
                android:textColor="#231f20"
                android:textSize="33sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                 android:textAppearance="@style/FontExtraBold"
                android:text="Password"
                android:textColor="#ffffff"
                android:textSize="33sp" />

        </LinearLayout>

        <common.CustomEditText
            android:layout_marginTop="28dp"
            android:id="@+id/resetPasswordEmailET"
            android:layout_width="match_parent"
            android:layout_height="@dimen/editTextSize"
            android:textCursorDrawable="@null"
            android:cursorVisible="true" />

        <common.CustomEditText
            android:id="@+id/resetOldPasswordEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/editTextSize"
            android:layout_marginTop="15dp"
            android:textCursorDrawable="@null"
            android:cursorVisible="true" />

        <common.CustomEditText
            android:id="@+id/resetNewPwdEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/editTextSize"
            android:layout_marginTop="15dp"
            android:textCursorDrawable="@null"
            android:cursorVisible="true" />

        <common.CustomEditText
            android:id="@+id/resetConfirmPwdEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/editTextSize"
            android:layout_marginTop="15dp"
            android:textCursorDrawable="@null"
            android:cursorVisible="true" />

        <Button
            android:id="@+id/resetSubmitButton"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="35dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="15dp"
            android:background="@drawable/rectangle_orange_bg"
           android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:text="@string/submit"
            android:textAllCaps="false"
            android:textColor="@color/white_3.1" />


    </LinearLayout>
</LinearLayout>

