<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingTop="@dimen/_30dp"
    android:paddingBottom="@dimen/_30dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_22dp"
        android:paddingEnd="@dimen/_22dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/back_image"
            android:layout_width="@dimen/back_icon_height_width"
            android:layout_height="@dimen/back_icon_height_width"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="center"
            android:src="@drawable/back_arrow"
            app:tint="@color/black_bg_3.1" />

        <ImageView
            android:layout_marginTop="@dimen/_3dp"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_gravity="left"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/back_image"
            android:layout_marginStart="@dimen/_10dp"
            android:src="@drawable/burbank_header_myplace_logo" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>