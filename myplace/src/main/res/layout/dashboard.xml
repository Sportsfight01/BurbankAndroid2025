<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appColor"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <include
            android:id="@+id/custom_tool"
            layout="@layout/custom_actionbar_transparent" />

        <LinearLayout
            android:id="@+id/notificationBtn"
            android:background="@drawable/rectangel_white_button"
            android:orientation="horizontal"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/_16dp"
            android:gravity="center"
            android:layout_marginTop="@dimen/_10dp"
            android:padding="@dimen/_5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_marginStart="@dimen/_5dp"
                android:src="@drawable/invitation_icon"
                android:layout_width="@dimen/_30dp"
                android:tint="@color/black"
                android:layout_height="@dimen/_20dp"/>
            <TextView
                android:id="@+id/invitation"
                android:text="Invitation"
                android:layout_marginEnd="@dimen/_10dp"
                android:layout_marginStart="@dimen/_10dp"
                 android:textAppearance="@style/FontMedium"
                android:textColor="@color/black"
                android:textSize="@dimen/default_text_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">


            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.9" />

            <LinearLayout
                android:id="@+id/ll_sign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:orientation="vertical"
                android:paddingStart="@dimen/_30dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                     android:textAppearance="@style/FontExtraBold"
                    android:text="Welcome"
                    android:textColor="#231f20"
                    android:textSize="33sp" />

                <TextView
                    android:id="@+id/welcomeDescTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6sp"
                    android:textColor="#ffffff"
                    android:textSize="33sp"
                    tools:text="In" />

            </LinearLayout>


            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.9" />

            <LinearLayout
                android:id="@+id/JobListView"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="@dimen/_16dp"
                android:layout_marginEnd="@dimen/_16dp"
                android:background="@drawable/rectangel_ten_radious_white"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:visibility="visible">
                <Spinner
                    android:id="@+id/jobNumbersSpinner"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:layout_weight="7"
                    android:background="@drawable/rectangel_spinner_radious" />

                <ImageView
                    android:layout_gravity="center"
                    android:layout_marginEnd="@dimen/_20dp"
                    android:background="@color/white"
                    android:src="@drawable/drop_down_bottom"
                    android:layout_width="@dimen/_20dp"
                    android:layout_height="@dimen/_20dp"/>

                <ImageView
                    android:id="@+id/addJobNumberImageView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/rectangel_one_side_radious"
                    android:padding="15dp"
                    android:src="@drawable/add_icon" />

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <common.CustomCircleBlocks
                        android:id="@+id/lineaLyProgress"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_margin="5dp">

                    </common.CustomCircleBlocks>

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="wrap_content" />

                    <common.CustomCircleBlocks
                        android:id="@+id/lineaLyPhotos"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_margin="5dp">


                    </common.CustomCircleBlocks>

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="wrap_content" />

                    <common.CustomCircleBlocks
                        android:id="@+id/lineaLyContract"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_margin="5dp">


                    </common.CustomCircleBlocks>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <common.CustomCircleBlocks
                        android:id="@+id/lineaLyFinance"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_margin="5dp" />

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="wrap_content" />

                    <common.CustomCircleBlocks
                        android:id="@+id/lineaLyDocuments"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_margin="5dp" />

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="wrap_content" />

                    <common.CustomCircleBlocks
                        android:id="@+id/lineaLyMore"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_margin="5dp" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.2" />

        </LinearLayout>


    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/drawer_layout_list"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_30dp"
            android:paddingStart="@dimen/_20dp"
            android:paddingEnd="@dimen/_10dp"
            android:paddingBottom="@dimen/_30dp">
            <ImageView

                android:id="@+id/burbankLogoImageView"
                android:layout_width="200dp"
                android:layout_height="33dp"
                android:layout_centerInParent="true"
                android:background="@android:color/transparent"
                android:src="@drawable/myplace_logo"
                android:visibility="invisible" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                 android:textAppearance="@style/FontMedium"
                android:gravity="left"
                android:layout_alignParentStart="true"
                android:layout_centerHorizontal="true"
                android:text="Notifications"
                android:textColor="@color/black"
                android:textSize="20sp" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/appColor"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:paddingStart="@dimen/_20dp"
            android:paddingEnd="@dimen/_10dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/notification_key_icon" />

                <TextView
                    android:id="@+id/notificationsJobNumberTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:text="Q1022"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textAppearance="@style/FontBold"/>
            </LinearLayout>


        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white"
            android:orientation="vertical">

            <ListView
                android:id="@+id/menuListView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:choiceMode="singleChoice"
                android:divider="@color/view_line"
                android:dividerHeight="1dp" />


            <TextView
                android:id="@+id/noNotificationTextView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@color/white"
                android:gravity="center"
                android:padding="15dp"
                android:text="Loading..."
                android:textColor="@color/black"
                android:textSize="16sp"
                android:visibility="visible" />

        </RelativeLayout>


    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>