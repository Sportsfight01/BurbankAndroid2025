<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_3.1"
    android:orientation="vertical"
    >
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:id="@+id/rr_welcome_profile"
        android:layout_weight="0.6">

        <include
            android:id="@+id/welcome_profile"
            layout="@layout/welcome_profile" />
    </RelativeLayout>

    <com.denzcoskun.imageslider.ImageSlider
        android:id="@+id/imageSlider"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.3"
        app:iss_auto_cycle="true"
        app:iss_corner_radius="5"
        app:iss_delay="10"
        android:visibility="gone"
        app:iss_placeholder="@color/white"
        android:background="@drawable/orange_border"
        app:iss_error_image="@android:color/darker_gray"
        app:iss_period="5000"
        android:isScrollContainer="true"
        app:iss_selected_dot="@drawable/selected_dot"
        app:iss_unselected_dot="@drawable/unselected_dot"
        app:iss_indicator_align="CENTER"
        app:iss_title_background="@android:color/transparent"
        app:iss_text_align="@string/center"
        />
    <ImageView
        android:id="@+id/welcome_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.5"
        app:iss_delay="10"
        android:scaleType="fitXY"
        android:visibility="visible"
        android:background="@drawable/orange_border"
       android:src="@drawable/welcome_slider_3"
        />

</LinearLayout>
