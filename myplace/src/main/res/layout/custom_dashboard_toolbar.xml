<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraint"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_45sdp"
    android:background="@color/new_gray_color"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.dmss.burbankappold.utils.CustomImageView
        android:id="@+id/ivNavMenu"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:src="@drawable/ic_menu"
        android:tint="@color/white_3.1"
        android:layout_marginStart="@dimen/_15sdp"
        android:layout_centerVertical="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <com.dmss.burbankappold.utils.CustomImageView
        android:id="@+id/ivToolBarBack"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:src="@drawable/ic_drawer_menu_forward"
        android:layout_marginStart="@dimen/_15sdp"
        android:visibility="gone"
        app:color="@color/white"
        android:rotation="180"
        android:layout_centerVertical="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>


    <com.dmss.burbankappold.utils.CustomImageView
        android:id="@+id/tv_toolbar_title"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        app:color="@color/white"
        android:src="@drawable/tool_bar_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/cl_iv_photo"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >
      <!--  <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_photo"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            app:civ_border_color="@color/white"
            app:civ_border_width="@dimen/_2sdp"
            android:src="@drawable/burbank_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />-->
        <com.dmss.burbankappold.utils.CustomImageView
            android:id="@+id/ivChat"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:src="@drawable/ic_toolbar_chat"
            android:layout_marginEnd="@dimen/_15sdp"
            app:color="@color/white_3.1"
            android:visibility="gone"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <TextView
            android:id="@+id/tv_notifications"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:textSize="@dimen/_8sdp"
            android:visibility="gone"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginEnd="-5dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/notification_circle"
            app:layout_constraintEnd_toEndOf="@+id/ivChat"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/line"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0.2dp"
        android:visibility="gone"
        android:background="@color/white_3.1" />
</androidx.constraintlayout.widget.ConstraintLayout>