<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_centerVertical="true"
    android:background="@color/white_3.1"
    android:orientation="vertical"
    >
<RelativeLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/rr_welcome_profile"
    android:padding="@dimen/_2ssp"
    android:layout_margin="@dimen/_12ssp"
   >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:id="@+id/cl_iv_photo"
        >
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_photo"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_50sdp"
        app:civ_border_color="@color/white"
        app:civ_border_width="@dimen/_2sdp"
        android:src="@drawable/burbank_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/tv_notifications_count"
        android:layout_width="@dimen/_16sdp"
        android:layout_height="@dimen/_16sdp"
        tools:text="2"
        android:textSize="@dimen/_8sdp"
        android:visibility="visible"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginEnd="@dimen/_2sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:background="@drawable/notification_circle"
        app:layout_constraintEnd_toEndOf="@+id/iv_photo"
        app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/ll_content"
        android:orientation="vertical"
        android:layout_marginLeft="@dimen/_10sdp"

        android:layout_toRightOf="@+id/cl_iv_photo">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:textAppearance="@style/FontRegular"
            android:id="@+id/profile_header"
            android:text="@string/my_home_care"
            android:textColor="@color/black_bg_3.1"
            android:textSize="@dimen/_24sdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:textSize="@dimen/_12sdp"
            android:justificationMode="none"
            android:maxLines="2"
            android:id="@+id/profile_sub_header"
             android:textAppearance="@style/FontRegular"
            android:textColor="@color/black_bg_3.1"
            android:text="@string/congratulation_text" />
    </LinearLayout>
</RelativeLayout>
</LinearLayout>