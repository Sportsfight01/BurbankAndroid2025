<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/_15sdp"
    android:orientation="vertical">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <CheckBox
            android:id="@+id/headerDot"
            android:checked="false"
            android:button="@drawable/faq_selected_dot"
            android:layout_width="@dimen/_7sdp"
            android:layout_height="@dimen/_7sdp"
            android:layout_gravity="center_vertical" />
        <TextView
            android:id="@+id/lblListHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/questionNo"
            android:text="@string/aboutBurbankText"
            android:textColor="@color/black"
            android:textSize="@dimen/_13sdp"
            tools:ignore="RtlSymmetry"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_drop_down" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@color/view_line"/>

    <common.JustifiedTextView
        android:id="@+id/faqAnswer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:gravity="center_vertical"
         android:textAppearance="@style/FontRegular"
        android:text="@string/app_name"
        android:justificationMode="inter_word"
        android:lineSpacingMultiplier="1.1"
        android:paddingStart="@dimen/_10sdp"
        android:textSize="@dimen/_11ssp"
        android:textColor="@color/black"
        tools:ignore="RtlSymmetry" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_marginStart="@dimen/_10sdp"
        android:background="@drawable/video_bg"
        android:layout_height="@dimen/_160sdp"
        android:layout_marginTop="@dimen/_10sdp">
      <!--<androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/videoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />-->
        <WebView
            android:id="@+id/videoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:scaleType="fitXY"
            />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_play"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:src="@drawable/zoom_video"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.appcompat.widget.LinearLayoutCompat>