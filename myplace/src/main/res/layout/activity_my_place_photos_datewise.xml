<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appColor"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/toolbar_detail_screen" />

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/opacity_orange"
            android:orientation="horizontal"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/photoNextMonthImageView"
                android:layout_width="25dp"
                android:layout_height="match_parent"
                android:src="@drawable/back_new_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/photoMonthNameTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="April"
                     android:textAppearance="@style/FontMedium"
                    android:textColor="@color/white"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/photoYearTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="2017"
                    android:layout_marginTop="@dimen/_5dp"
                     android:textAppearance="@style/FontMedium"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_20sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/photoPreviousMonthImageView"
                android:layout_width="25dp"
                android:layout_height="match_parent"
                android:rotation="180"
                android:src="@drawable/back_new_icon" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/jobNumberLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/jobnumber" />

                <TextView
                    android:id="@+id/favJobNumberTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="10dp"
                    android:gravity="center"
                    android:text="Q1022"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textAppearance="@style/FontBold"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/black" />

        </LinearLayout>

        <ListView
            android:id="@+id/photoListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/view_line"
            android:dividerHeight="1dp"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/emptyElement"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/emptyTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No photos to display"
                android:textColor="@color/black"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/retryTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/orange_btn_fullcolor"
                android:padding="5dp"
                android:text="Reload"
                android:textColor="@color/white"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>


</RelativeLayout>
