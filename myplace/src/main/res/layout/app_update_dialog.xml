<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_roundcorner_background"
    android:orientation="vertical">

    <!--Sandeep-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_heading_background"
        android:gravity="center"
        android:padding="18dp"
        android:text="Notice"
        android:textColor="@color/black"
        android:textSize="20sp" />


    <TextView
        android:id="@+id/updateMessageTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/app_name"
        android:textColor="@color/black"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:visibility="visible"
        android:orientation="horizontal"
        android:padding="10dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Button
            android:id="@+id/updateAppButton"
            android:layout_width="@dimen/button_width"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/orange_color_btn"
            android:stateListAnimator="@null"
            android:text="Update"
            android:textAllCaps="false"
            android:textColor="@color/fontColorOrange"
            android:textSize="17sp"
            android:textAppearance="@style/FontRegular"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_weight="1" />

        <Button
            android:id="@+id/notNowButton"
            android:layout_width="@dimen/button_width"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:background="@drawable/orange_color_btn"
            android:stateListAnimator="@null"
            android:text="Ok"
            android:textAllCaps="false"
            android:textColor="@color/fontColorOrange"
            android:textSize="17sp"
            android:textAppearance="@style/FontRegular"
            android:visibility="visible" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"/>

</LinearLayout>