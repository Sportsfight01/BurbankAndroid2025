<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/editTextSize"
        android:layout_gravity="center"
        android:background="@drawable/myplace_edittext_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_10dp"
            android:paddingEnd="@dimen/_10dp">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/editTextIconSize"
                android:layout_height="@dimen/editTextIconSize"
                android:layout_margin="2dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:src="@drawable/key_icon"
                android:visibility="visible" />

            <EditText

                android:id="@+id/customEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:cursorVisible="true"
                 android:textAppearance="@style/FontRegular"
                android:gravity="center_vertical"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:paddingLeft="5dp"
                android:paddingTop="10dp"
                android:paddingRight="5dp"
                android:paddingBottom="10dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textCursorDrawable="@drawable/balck_cursor"
                android:textSize="@dimen/sixteen" />
        </LinearLayout>


        <View
            android:id="@+id/disableView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.3"
            android:background="@drawable/disablededittext"
            android:visibility="gone" />

    </RelativeLayout>

</LinearLayout>