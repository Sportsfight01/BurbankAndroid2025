<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include layout="@layout/toolbar_detail_screen" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/appColor"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/mLLyFinanceDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="27dp"
            android:orientation="horizontal"
            android:visibility="gone"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginRight="@dimen/_10dp"
                android:layout_weight="1"
                android:background="@drawable/rectangel_white_button"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="27sp"
                    android:text="Job Number"
                    android:textColor="#231f20"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/mTxtJobNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="21sp"
                    android:textColor="#f68521"
                    android:textSize="18sp"
                    tools:text="136857" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_10dp"
                android:layout_weight="1"
                android:background="@drawable/rectangel_white_button"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="27sp"
                    android:text="Job Number"
                    android:textColor="#231f20"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/mTxtContractValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="21sp"
                    android:textColor="#f68521"
                    android:textSize="18sp"
                    tools:text="136857" />
            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/jobNumberLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/opacity_orange"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/notification_key_icon" />

                <TextView
                    android:id="@+id/documentsJobNumberTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:gravity="center"
                    android:text="Q1022"
                     android:textAppearance="@style/FontExtraBold"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                     />
            </LinearLayout>

        </LinearLayout>

        <ListView
            android:id="@+id/lVMyDocumentsId"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_10dp"
            android:layout_marginEnd="@dimen/_10dp"
            android:scrollbars="none"
            android:visibility="visible"
            android:divider="@color/transparent"
            ></ListView>

        <WebView
            android:id="@+id/documentImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>